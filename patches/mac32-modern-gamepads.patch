@@ -0,0 +1,20 @@
+#pragma once
+#import <Foundation/Foundation.h>
+#import <IOKit/hid/IOHIDManager.h>
+
+#define DIRT3_GAMEPAD_VENDOR 0x4d33
+#define DIRT3_GAMEPAD_PRODUCT 1
+
+void dirt3_gamepad_matching(IOHIDManagerRef manager, IOHIDDeviceCallback callback, void *context);
+void dirt3_gamepad_removal(IOHIDManagerRef manager, IOHIDDeviceCallback callback, void *context);
+void dirt3_gamepad_input(IOHIDManagerRef manager, IOHIDValueCallback callback, void *context);
+void dirt3_gamepad_close(IOHIDManagerRef manager);
+CFTypeRef dirt3_gamepad_property(IOHIDDeviceRef device, CFStringRef key);
+void dirt3_gamepad_unschedule(IOHIDDeviceRef device, CFRunLoopRef loop, CFStringRef mode);
+IOHIDDeviceRef dirt3_gamepad_element_device(IOHIDElementRef element);
+IOHIDElementCookie dirt3_gamepad_element_cookie(IOHIDElementRef element);
+uint32_t dirt3_gamepad_element_usage(IOHIDElementRef element);
+uint32_t dirt3_gamepad_element_usage_page(IOHIDElementRef element);
+IOHIDElementRef dirt3_gamepad_value_element(IOHIDValueRef value);
+CFIndex dirt3_gamepad_value_integer(IOHIDValueRef value);
+uint64_t dirt3_gamepad_value_time(IOHIDValueRef value);
diff --git a/src/dirt3_gamepad.m b/src/dirt3_gamepad.m
new file mode 100644
index 0000000..89a9680
--- /dev/null
+++ b/src/dirt3_gamepad.m
@@ -0,0 +1,240 @@
+// Expose one modern controller to DiRT 3's original input backend. The
+// synthetic device and HID values exist only inside the guest's callbacks.
+#import <AppKit/AppKit.h>
+#import <GameController/GameController.h>
+#import <mach/mach_time.h>
+#include <math.h>
+#include "dirt3_gamepad.h"
+#include "mac32.h"
+
+extern int dirt3_version_patch_active(void);
+
+enum {
+    button_x, button_a, button_b, button_y, left_shoulder, right_shoulder,
+    back, start, left_thumb, right_thumb,
+    left_x, left_y, right_x, right_y, left_trigger, right_trigger, hat,
+    control_count
+};
+static const uint8_t usages[] = {1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 48, 49, 50, 53, 51, 52, 57};
+
+static struct {
+    IOHIDManagerRef manager;
+    IOHIDDeviceCallback matching, removal;
+    IOHIDValueCallback input;
+    void *matching_context, *removal_context, *input_context;
+    NSTimer *timer;
+    GCController *controller;
+    int previous[control_count];
+    bool initialized;
+} bridge;
+
+// Stable, opaque handles for the guest. Never pass these to host IOKit.
+#define DEVICE ((IOHIDDeviceRef)CFSTR("mac32 DiRT 3 gamepad device"))
+#define VALUE ((IOHIDValueRef)CFSTR("mac32 DiRT 3 gamepad value"))
+static const CFStringRef element_tokens[control_count] = {
+    CFSTR("mac32 pad X"), CFSTR("mac32 pad A"), CFSTR("mac32 pad B"), CFSTR("mac32 pad Y"),
+    CFSTR("mac32 pad LB"), CFSTR("mac32 pad RB"), CFSTR("mac32 pad Back"), CFSTR("mac32 pad Start"),
+    CFSTR("mac32 pad L3"), CFSTR("mac32 pad R3"), CFSTR("mac32 pad LX"), CFSTR("mac32 pad LY"),
+    CFSTR("mac32 pad RX"), CFSTR("mac32 pad RY"), CFSTR("mac32 pad LT"), CFSTR("mac32 pad RT"),
+    CFSTR("mac32 pad D-pad"),
+};
+
+static _Thread_local struct {
+    IOHIDElementRef element;
+    int value;
+    uint64_t time;
+} sample;
+
+static int element_index(IOHIDElementRef element)
+{
+    if (element) {
+        for (int index = 0; index < control_count; ++index)
+            if ((CFTypeRef)element == element_tokens[index]) return index;
+    }
+    return -1;
+}
+
+CFTypeRef dirt3_gamepad_property(IOHIDDeviceRef device, CFStringRef key)
+{
+    if (device != DEVICE) return IOHIDDeviceGetProperty(device, key);
+    static NSDictionary *properties;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        properties = [@{@kIOHIDVendorIDKey: @(DIRT3_GAMEPAD_VENDOR),
+            @kIOHIDProductIDKey: @(DIRT3_GAMEPAD_PRODUCT), @kIOHIDPrimaryUsagePageKey: @1,
+            @kIOHIDPrimaryUsageKey: @5, @kIOHIDProductKey: @"Modern Gamepad",
+            @kIOHIDTransportKey: @"Virtual"} retain];
+    });
+    return (CFTypeRef)properties[(NSString *)key];
+}
+
+void dirt3_gamepad_unschedule(IOHIDDeviceRef device, CFRunLoopRef loop, CFStringRef mode)
+{
+    if (device != DEVICE) IOHIDDeviceUnscheduleFromRunLoop(device, loop, mode);
+}
+
+IOHIDDeviceRef dirt3_gamepad_element_device(IOHIDElementRef element)
+{
+    return element_index(element) >= 0 ? DEVICE : IOHIDElementGetDevice(element);
+}
+
+IOHIDElementCookie dirt3_gamepad_element_cookie(IOHIDElementRef element)
+{
+    int index = element_index(element);
+    return index >= 0 ? (IOHIDElementCookie)(index + 1) : IOHIDElementGetCookie(element);
+}
+
+uint32_t dirt3_gamepad_element_usage(IOHIDElementRef element)
+{
+    int index = element_index(element);
+    return index >= 0 ? usages[index] : IOHIDElementGetUsage(element);
+}
+
+uint32_t dirt3_gamepad_element_usage_page(IOHIDElementRef element)
+{
+    int index = element_index(element);
+    return index >= 0 ? (index < left_x ? 9 : 1) : IOHIDElementGetUsagePage(element);
+}
+
+IOHIDElementRef dirt3_gamepad_value_element(IOHIDValueRef value)
+{
+    return value == VALUE ? sample.element : IOHIDValueGetElement(value);
+}
+
+CFIndex dirt3_gamepad_value_integer(IOHIDValueRef value)
+{
+    return value == VALUE ? sample.value : IOHIDValueGetIntegerValue(value);
+}
+
+uint64_t dirt3_gamepad_value_time(IOHIDValueRef value)
+{
+    return value == VALUE ? sample.time : IOHIDValueGetTimeStamp(value);
+}
+
+static int stick(float value) { return (int)lroundf((value + 1.f) * 127.5f); }
+static int trigger(float value) { return (int)lroundf(value * 255.f); }
+
+static void read_gamepad(GCExtendedGamepad *pad, int current[control_count])
+{
+    current[left_x] = stick(0);
+    current[left_y] = stick(0);
+    current[right_x] = stick(0);
+    current[right_y] = stick(0);
+    current[hat] = 8;
+    if (!pad) return;
+
+    current[button_a] = pad.buttonA.isPressed;
+    current[button_b] = pad.buttonB.isPressed;
+    current[button_x] = pad.buttonX.isPressed;
+    current[button_y] = pad.buttonY.isPressed;
+    current[left_shoulder] = pad.leftShoulder.isPressed;
+    current[right_shoulder] = pad.rightShoulder.isPressed;
+    current[back] = pad.buttonOptions.isPressed;
+    current[start] = pad.buttonMenu.isPressed;
+    current[left_thumb] = pad.leftThumbstickButton.isPressed;
+    current[right_thumb] = pad.rightThumbstickButton.isPressed;
+    current[left_x] = stick(pad.leftThumbstick.xAxis.value);
+    current[left_y] = stick(-pad.leftThumbstick.yAxis.value);
+    current[right_x] = stick(pad.rightThumbstick.xAxis.value);
+    current[right_y] = stick(-pad.rightThumbstick.yAxis.value);
+    current[left_trigger] = trigger(pad.leftTrigger.value);
+    current[right_trigger] = trigger(pad.rightTrigger.value);
+    static const int hats[3][3] = {{5, 4, 3}, {6, 8, 2}, {7, 0, 1}};
+    int x = pad.dpad.right.isPressed - pad.dpad.left.isPressed;
+    int y = pad.dpad.up.isPressed - pad.dpad.down.isPressed;
+    current[hat] = hats[y + 1][x + 1];
+}
+
+static void deliver_input(GCExtendedGamepad *pad)
+{
+    if (!bridge.input) return;
+    int current[control_count] = {0};
+    read_gamepad(pad, current);
+    uint64_t now = mach_absolute_time();
+    for (int i = 0; i < control_count && bridge.input; ++i) {
+        if (bridge.initialized && current[i] == bridge.previous[i]) continue;
+        sample.element = (IOHIDElementRef)element_tokens[i];
+        sample.value = current[i];
+        sample.time = now;
+        bridge.input(bridge.input_context, kIOReturnSuccess, DEVICE, VALUE);
+    }
+    memcpy(bridge.previous, current, sizeof(current));
+    bridge.initialized = true;
+}
+
+static bool uses_native_dualsense(GCController *controller)
+{
+    // The standard DualSense has its own USB and Bluetooth input, rumble and
+    // adaptive-trigger bridge. Other Sony models can use the common profile.
+    return [controller.extendedGamepad isKindOfClass:[GCDualSenseGamepad class]] &&
+        ![controller.vendorName localizedCaseInsensitiveContainsString:@"Edge"];
+}
+
+static void update_gamepad(void)
+{
+    if (!bridge.matching || !bridge.input) return;
+    NSArray<GCController *> *controllers = GCController.controllers;
+    if (bridge.controller && ![controllers containsObject:bridge.controller]) {
+        deliver_input(nil);
+        if (bridge.removal) bridge.removal(bridge.removal_context, kIOReturnSuccess, bridge.manager, DEVICE);
+        [bridge.controller release];
+        bridge.controller = nil;
+    }
+    if (!bridge.controller) {
+        for (GCController *candidate in controllers) {
+            if (!candidate.extendedGamepad || uses_native_dualsense(candidate)) continue;
+            bridge.controller = [candidate retain];
+            bridge.initialized = false;
+            bridge.matching(bridge.matching_context, kIOReturnSuccess, bridge.manager, DEVICE);
+            LOG("DiRT 3 gamepad: %s through macOS Game Controller\n", candidate.vendorName.UTF8String ?: "Gamepad");
+            break;
+        }
+    }
+    if (bridge.controller) deliver_input(NSApp.isActive ? bridge.controller.extendedGamepad : nil);
+}
+
+// Both Feral's HID manager and AppKit's controller backend run on the main
+// run loop. Keep guest callbacks there and also detect unplug/reconnect.
+static bool use_bridge(IOHIDManagerRef manager)
+{
+    return [NSThread isMainThread] && dirt3_version_patch_active() &&
+        (!bridge.manager || bridge.manager == manager);
+}
+
+void dirt3_gamepad_matching(IOHIDManagerRef manager, IOHIDDeviceCallback callback, void *context)
+{
+    if (!use_bridge(manager)) return;
+    bridge.manager = manager;
+    bridge.matching = callback;
+    bridge.matching_context = context;
+}
+
+void dirt3_gamepad_removal(IOHIDManagerRef manager, IOHIDDeviceCallback callback, void *context)
+{
+    if (!use_bridge(manager)) return;
+    bridge.manager = manager;
+    bridge.removal = callback;
+    bridge.removal_context = context;
+}
+
+void dirt3_gamepad_input(IOHIDManagerRef manager, IOHIDValueCallback callback, void *context)
+{
+    if (!use_bridge(manager)) return;
+    bridge.manager = manager;
+    bridge.input = callback;
+    bridge.input_context = context;
+    if (!bridge.timer && callback) {
+        bridge.timer = [NSTimer timerWithTimeInterval:1.0 / 120.0 repeats:YES block:^(NSTimer *timer) {
+            update_gamepad();
+        }];
+        [[NSRunLoop mainRunLoop] addTimer:bridge.timer forMode:NSRunLoopCommonModes];
+    }
+}
+
+void dirt3_gamepad_close(IOHIDManagerRef manager)
+{
+    if (bridge.manager != manager) return;
+    [bridge.timer invalidate];
+    [bridge.controller release];
+    memset(&bridge, 0, sizeof bridge);
+}
