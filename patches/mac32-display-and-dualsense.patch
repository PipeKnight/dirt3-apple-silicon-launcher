+static int terminal_flash(g32 state)
+{
+	// In both shipped state graphs, only the terminal crash transitions
+	// enable slowMo or rampSlowMo on StateFlashbackTransition.
+	const uint8_t *bytes = G2H(state);
+	return bytes[0xae] || bytes[0xaf];
+}
+
+static void terminal_flash_enter(uint32_t *args, struct hres *r)
+{
+	RET(gcall(flash_enter, 2, A(0), A(1)));
+	if (terminal_flash(A(0))) dirt3_terminal_slow_motion(true);
+}
+
+static void terminal_flash_exit(uint32_t *args, struct hres *r)
+{
+	int terminal = terminal_flash(A(0));
+	RET(gcall(flash_exit, 1, A(0)));
+	if (terminal) dirt3_terminal_slow_motion(false);
+}
+
+static void terminal_flash_tick(uint32_t *args, struct hres *r)
+{
+	RET(gcall(flash_tick, 3, A(0), A(1), A(2)));
+	if (terminal_flash(A(0))) {
+		const uint8_t *state = G2H(A(0));
+		float elapsed;
+		memcpy(&elapsed, state + 0x34, sizeof elapsed);
+		// The ramp restores normal speed when 0.1 + (2 * elapsed)^2 >= 1.
+		dirt3_terminal_slow_motion(!state[0xaf] || elapsed < 0.47434165f);
+	}
+}
