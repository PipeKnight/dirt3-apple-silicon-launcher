+static void serialize_motion_with_damage(uint32_t *args, struct hres *r)
+{
+	// The second argument is the same player vehicle the serializer uses
+	// for pedal and gear signals. The audio code reads engine damage here.
+	g32 vehicle = A(1);
+	float damage = 0;
+	if (vehicle >= LOW_START && vehicle <= LOW_END - 0xb99c - sizeof damage)
+		memcpy(&damage, G2H(vehicle + 0xb99c), sizeof damage);
+	float previous = dirt3_set_motion_engine_damage(damage);
+	RET(gcall(serialize_motion, 8, A(0), A(1), A(2), A(3), A(4), A(5), A(6), A(7)));
+	dirt3_set_motion_engine_damage(previous);
+}
