diff --git a/src/dirt3_adaptive_triggers.m b/src/dirt3_adaptive_triggers.m
new file mode 100644
index 0000000..1a61ee4
--- /dev/null
+++ b/src/dirt3_adaptive_triggers.m
@@ -0,0 +1,389 @@
+// DiRT 3's extended motion report supplies the two virtual pedal signals.
+// Route the built-in D-Box defaults to a private address inside this process.
+#import <AppKit/AppKit.h>
+#import <IOKit/hid/IOHIDLib.h>
+#import <IOKit/hid/IOHIDKeys.h>
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <math.h>
+#include <os/lock.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <zlib.h>
+#include "mac32.h"
+
+#define LOCAL_IP "127.1.2.3"
+#define LOCAL_PORT 9
+#define MOTION_PREFIX "<motion enabled=\"true\" ip=\""
+#define MOTION_DEFAULT MOTION_PREFIX "dbox\" port=\"20777\" delay=\"1\" extradata=\"0\" />"
+#define MOTION_LOCAL MOTION_PREFIX LOCAL_IP "\" port=\"9\" delay=\"1\" extradata=\"3\""
+
+static const char default_motion[] = MOTION_DEFAULT;
+static const char local_motion[] = MOTION_LOCAL "/>";
+static const char saved_motion[] = MOTION_LOCAL " />";
+
+_Static_assert(sizeof(default_motion) == sizeof(local_motion), "the game reads the original file size");
+
+static bool enabled, configured;
+static atomic_bool routed;
+static os_unfair_lock motion_lock = OS_UNFAIR_LOCK_INIT;
+static float stage_time;
+static double last_advance;
+static unsigned brake_level;
+static float brake_force;
+static double brake_slip_since;
+static int forward_gear;
+static double forward_gear_at, shift_until;
+static _Thread_local float player_engine_damage;
+
+struct trigger_effect {
+    uint8_t level;
+    uint8_t start_zone;
+};
+static struct trigger_effect engine_effect;
+
+static IOHIDDeviceRef hid_pad;
+static os_unfair_lock hid_lock = OS_UNFAIR_LOCK_INIT;
+static double hid_retry_at;
+static bool bluetooth;
+static uint8_t bluetooth_sequence;
+static struct trigger_effect applied[2];
+static bool trace;
+void dirt3_adaptive_triggers_reset_idle_device(void);
+void dirt3_adaptive_triggers_shutdown(void);
+
+float dirt3_set_motion_engine_damage(float damage)
+{
+    float previous = player_engine_damage;
+    player_engine_damage = damage >= 0 && damage <= 1 ? damage : 0;
+    return previous;
+}
+
+void dirt3_adaptive_triggers_init(void)
+{
+    const char *option = getenv("MAC32_DIRT3_ADAPTIVE_TRIGGERS");
+    enabled = option && !strcmp(option, "1");
+    configured = enabled || (option && !strcmp(option, "0"));
+    trace = getenv("MAC32_TRACE_DUALSENSE_FF") != NULL;
+    if (enabled) atexit(dirt3_adaptive_triggers_shutdown);
+    dirt3_adaptive_triggers_reset_idle_device();
+}
+
+static bool is_hardware_config(int fd)
+{
+    char path[PATH_MAX];
+    if (fcntl(fd, F_GETPATH, path) < 0) return false;
+    const char *base = strrchr(path, '/');
+    return base && !strcmp(base + 1, "hardware_settings_config.xml");
+}
+
+void dirt3_adaptive_triggers_config_read(int fd, void *bytes, int32_t size)
+{
+    if (!enabled || size < (int32_t)sizeof(default_motion) - 1) return;
+    char *tag = memmem(bytes, (size_t)size, default_motion, sizeof(default_motion) - 1);
+    if (!tag || !is_hardware_config(fd)) return;
+    memcpy(tag, local_motion, sizeof(local_motion) - 1);
+    if (!atomic_exchange(&routed, true)) LOG("DiRT 3: enabled in-process motion for adaptive triggers\n");
+}
+
+int32_t dirt3_adaptive_triggers_config_write(int fd, const void *bytes, uint32_t size, off_t offset)
+{
+    if (atomic_load(&routed) && size >= sizeof(local_motion) - 1 && size <= 128 * 1024) {
+        const char *tag = memmem(bytes, size, saved_motion, sizeof(saved_motion) - 1);
+        size_t padding = tag ? sizeof(saved_motion) - sizeof(default_motion) : 0;
+        if (!tag) tag = memmem(bytes, size, local_motion, sizeof(local_motion) - 1);
+        if (tag && is_hardware_config(fd)) {
+            // The game writes the full XML. Restore its D-Box setting before
+            // writing and keep the serialized byte count for its file API.
+            char *restored = malloc(size);
+            if (!restored) { errno = ENOMEM; return -1; }
+            memcpy(restored, bytes, size);
+            char *destination = restored + (tag - (const char *)bytes);
+            memcpy(destination, default_motion, sizeof(default_motion) - 1);
+            memset(destination + sizeof(default_motion) - 1, ' ', padding);
+            int32_t result = (int32_t)pwrite(fd, restored, size, offset);
+            free(restored);
+            return result;
+        }
+    }
+    return (int32_t)pwrite(fd, bytes, size, offset);
+}
+
+static double seconds(void)
+{
+    return (double)clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1e9;
+}
+
+static float clamp_unit(float value)
+{
+    return fmaxf(0, fminf(1, value));
+}
+
+static IOHIDDeviceRef open_dualsense(void)
+{
+    IOHIDManagerRef manager = IOHIDManagerCreate(NULL, kIOHIDOptionsTypeNone);
+    if (!manager) return NULL;
+    NSDictionary *matching = @{
+        @kIOHIDVendorIDKey: @0x054c, @kIOHIDProductIDKey: @0x0ce6,
+        @kIOHIDPrimaryUsagePageKey: @1, @kIOHIDPrimaryUsageKey: @5,
+    };
+    IOHIDManagerSetDeviceMatching(manager, (CFDictionaryRef)matching);
+    CFSetRef devices = IOHIDManagerCopyDevices(manager);
+    IOHIDDeviceRef device = NULL;
+    if (devices && CFSetGetCount(devices) == 1) {
+        CFSetGetValues(devices, (const void **)&device);
+        CFTypeRef size = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDMaxOutputReportSizeKey));
+        int length = 0;
+        if (size && CFGetTypeID(size) == CFNumberGetTypeID())
+            CFNumberGetValue(size, kCFNumberIntType, &length);
+        CFTypeRef transport = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDTransportKey));
+        bool wired = transport && CFEqual(transport, CFSTR("USB")) && length == 48;
+        bool wireless = transport && CFEqual(transport, CFSTR("Bluetooth")) && length >= 78;
+        if ((wired || wireless) && IOHIDDeviceOpen(device, kIOHIDOptionsTypeNone) == kIOReturnSuccess) {
+            bluetooth = wireless;
+            CFRetain(device);
+        } else {
+            device = NULL;
+        }
+    }
+    if (devices) CFRelease(devices);
+    CFRelease(manager);
+    return device;
+}
+
+static void encode_trigger(uint8_t *effect, struct trigger_effect setting)
+{
+    unsigned level = setting.level;
+    effect[0] = level ? 0x21 : 0x05; // zoned resistance or off
+    if (!level) return;
+
+    uint16_t mask = 0;
+    uint32_t strengths = 0;
+    for (unsigned zone = setting.start_zone; zone <= 9; ++zone) {
+        unsigned force = 1 + (level - 1) * (zone - setting.start_zone) / (9 - setting.start_zone);
+        mask |= 1u << zone;
+        strengths |= (force - 1) << (3 * zone);
+    }
+    effect[1] = (uint8_t)mask;
+    effect[2] = (uint8_t)(mask >> 8);
+    for (unsigned byte = 0; byte < 4; ++byte)
+        effect[3 + byte] = (uint8_t)(strengths >> (8 * byte));
+}
+
+static bool send_triggers(const struct trigger_effect effects[2])
+{
+    // Both framing formats share the effect banks. Only the two trigger
+    // validity flags are set, leaving rumble, audio and LEDs alone.
+    uint8_t report[78] = {0}, *payload = report + (bluetooth ? 3 : 1);
+    payload[0] = 0x0c;
+    encode_trigger(payload + 10, effects[1]);
+    encode_trigger(payload + 21, effects[0]);
+    size_t length = 48;
+    report[0] = 0x02;
+    if (bluetooth) {
+        report[0] = 0x31;
+        report[1] = (bluetooth_sequence++ & 0xf) << 4;
+        report[2] = 0x10;
+        const uint8_t seed = 0xa2;
+        uint32_t checksum = (uint32_t)crc32(crc32(0, &seed, 1), report, 74);
+        for (unsigned byte = 0; byte < 4; ++byte)
+            report[74 + byte] = (uint8_t)(checksum >> (8 * byte));
+        length = sizeof(report);
+    }
+    IOReturn result = IOHIDDeviceSetReport(hid_pad, kIOHIDReportTypeOutput, report[0], report, length);
+    const char *link = bluetooth ? "Bluetooth" : "USB";
+    if (trace && result == kIOReturnSuccess)
+        LOG("DiRT 3 adaptive triggers: L2=%u R2=%u (%s)\n", effects[0].level, effects[1].level, link);
+    else if (result != kIOReturnSuccess)
+        LOG("DiRT 3 adaptive triggers: %s report failed (%#x)\n", link, result);
+    return result == kIOReturnSuccess;
+}
+
+static void close_triggers(void)
+{
+    if (!hid_pad) return;
+    struct trigger_effect off[2] = {0};
+    if (applied[0].level || applied[1].level) send_triggers(off);
+    IOHIDDeviceClose(hid_pad, kIOHIDOptionsTypeNone);
+    CFRelease(hid_pad);
+    hid_pad = NULL;
+    memset(applied, 0, sizeof(applied));
+}
+
+void dirt3_adaptive_triggers_shutdown(void)
+{
+    os_unfair_lock_lock(&hid_lock);
+    close_triggers();
+    os_unfair_lock_unlock(&hid_lock);
+}
+
+void dirt3_adaptive_triggers_reset_idle_device(void)
+{
+    if (!configured) return;
+    @autoreleasepool {
+        os_unfair_lock_lock(&hid_lock);
+        if (!hid_pad) {
+            hid_pad = open_dualsense();
+            if (hid_pad) {
+                const struct trigger_effect off[2] = {0};
+                send_triggers(off);
+                close_triggers();
+            }
+        }
+        os_unfair_lock_unlock(&hid_lock);
+    }
+}
+
+static void update_triggers(void)
+{
+    struct trigger_effect next[2] = {0};
+    double time = seconds();
+    os_unfair_lock_lock(&motion_lock);
+    if (time - last_advance < 0.25) {
+        if (brake_level) {
+            next[0] = (struct trigger_effect){.level = brake_level, .start_zone = 3};
+            if (brake_slip_since && fmod(time - brake_slip_since, 0.125) >= 0.065)
+                next[0] = (struct trigger_effect){0};
+        }
+        next[1] = engine_effect;
+        if (time < shift_until) {
+            next[1].level = next[1].level + 2;
+            next[1].start_zone = 2;
+        }
+    }
+    os_unfair_lock_unlock(&motion_lock);
+    bool active = NSApp.isActive;
+    os_unfair_lock_lock(&hid_lock);
+    if (!active) {
+        close_triggers();
+    } else {
+        if (!hid_pad && (next[0].level || next[1].level) && time >= hid_retry_at) {
+            hid_pad = open_dualsense();
+            hid_retry_at = time + 1;
+        }
+        if (hid_pad && memcmp(next, applied, sizeof(applied))) {
+            if (send_triggers(next)) memcpy(applied, next, sizeof(applied));
+            else close_triggers();
+        }
+    }
+    os_unfair_lock_unlock(&hid_lock);
+}
+
+static void start_updates(void)
+{
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        dispatch_async(dispatch_get_main_queue(), ^{
+            NSNotificationCenter *notifications = NSNotificationCenter.defaultCenter;
+            [notifications addObserverForName:NSApplicationWillTerminateNotification object:NSApp
+                queue:nil usingBlock:^(NSNotification *note) { dirt3_adaptive_triggers_shutdown(); }];
+            dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+            dispatch_source_set_timer(timer, DISPATCH_TIME_NOW, NSEC_PER_SEC / 30, NSEC_PER_MSEC * 3);
+            dispatch_source_set_event_handler(timer, ^{
+                @autoreleasepool { update_triggers(); }
+            });
+            dispatch_activate(timer);
+        });
+    });
+}
+
+static unsigned resistance_level(float strength, unsigned previous)
+{
+    if (strength <= 0.0f) return 0;
+    // Keep small changes around a boundary from toggling the motor repeatedly.
+    if (fabsf(strength - (float)previous) < 0.65f) return previous;
+    return (unsigned)roundf(strength);
+}
+
+bool dirt3_adaptive_triggers_send(const void *bytes, uint32_t size, const struct sockaddr *address, uint32_t address_size)
+{
+    if (!atomic_load(&routed) || !address || address_size < sizeof(struct sockaddr_in) ||
+        address->sa_family != AF_INET) return false;
+    const struct sockaddr_in *target = (const struct sockaddr_in *)address;
+    if (target->sin_port != htons(LOCAL_PORT) || target->sin_addr.s_addr != inet_addr(LOCAL_IP)) return false;
+
+    // Extra data mode 3 contains 38 little-endian floats on both Mac builds.
+    float data[38];
+    if (size != sizeof(data)) return true;
+    memcpy(data, bytes, sizeof(data));
+    float stage = data[0], speed = data[7], wheel_left = data[27], wheel_right = data[28];
+    float brake = data[31], gear = data[33], longitudinal_g = data[35];
+    if (!isfinite(stage) || stage < 0 || !isfinite(speed) || speed < 0 ||
+        !isfinite(wheel_left) || !isfinite(wheel_right) ||
+        !(brake >= 0 && brake <= 1)) return true;
+
+    os_unfair_lock_lock(&motion_lock);
+    float step = fmaxf(0, fminf(stage - stage_time, 0.08f));
+    if (stage > stage_time || stage_time - stage > 1.0f) {
+        double now = seconds();
+        if (now - last_advance >= 0.25 || stage < stage_time) {
+            brake_level = 0;
+            brake_force = 0;
+            brake_slip_since = 0;
+            forward_gear = 0;
+            shift_until = 0;
+        }
+        if (stage > 0 && speed > 2 && gear >= 1 && gear <= 9 && gear == (int)gear) {
+            // A short trip through neutral during a shift keeps the old gear.
+            // Seed the first gear without firing on starts or after a pause.
+            if (forward_gear && forward_gear != (int)gear && now - forward_gear_at < 0.35) {
+                shift_until = now + 0.15;
+                if (trace) LOG("DiRT 3 adaptive triggers: shift %d -> %d\n", forward_gear, (int)gear);
+            }
+            forward_gear = (int)gear;
+            forward_gear_at = now;
+        } else if (stage <= 0 || speed <= 2 || gear != 0) {
+            forward_gear = 0;
+            shift_until = 0;
+        }
+        last_advance = now;
+    }
+    stage_time = stage;
+    // Use the actual engine damage, leaving a nearly undamaged throttle light.
+    struct trigger_effect previous_engine = engine_effect;
+    engine_effect = (struct trigger_effect){0};
+    if (stage > 0 && player_engine_damage >= 0.15f) {
+        // At low damage, expose only the last two zones at minimum force.
+        // Grow the affected travel before increasing peak motor force.
+        unsigned reach = (unsigned)roundf(4.f * (player_engine_damage - 0.15f) / 0.85f);
+        engine_effect = (struct trigger_effect){
+            .level = 1 + (player_engine_damage >= 0.50f) + (player_engine_damage >= 0.75f),
+            .start_zone = 8 - reach,
+        };
+    }
+    if (trace && memcmp(&engine_effect, &previous_engine, sizeof(engine_effect)))
+        LOG("DiRT 3 adaptive triggers: engine damage %.3f, throttle force %u from zone %u\n",
+            player_engine_damage, engine_effect.level, engine_effect.start_zone);
+    if (stage > 0) {
+        float wheels = (fabsf(wheel_left) + fabsf(wheel_right)) * 0.5f;
+        float braking = speed > 3 ? clamp_unit((brake - 0.20f) / 0.80f) : 0;
+        float slip = speed > 3 ? clamp_unit((speed - wheels) / speed) : 0;
+        float target_force = braking * (3.0f + slip);
+        if (target_force == 0) brake_force = 0;
+        else brake_force += (target_force - brake_force) * -expm1f(-step / 0.030f);
+        brake_level = resistance_level(brake_force, brake_level);
+        // The motion stream has wheel speeds and acceleration. Use both to
+        // estimate braking slip without assuming the game's ABS is active.
+        bool slipping = speed > 5 && brake >= 0.55f &&
+            longitudinal_g <= -0.20f && longitudinal_g > -3.0f &&
+            slip >= (brake_slip_since ? 0.09f : 0.16f);
+        if (!slipping) brake_slip_since = 0;
+        else if (!brake_slip_since) {
+            brake_slip_since = last_advance;
+            if (trace) LOG("DiRT 3 adaptive triggers: braking slip %.2f\n", slip);
+        }
+    } else {
+        brake_level = 0;
+        brake_force = 0;
+        brake_slip_since = 0;
+    }
+    os_unfair_lock_unlock(&motion_lock);
+    if (trace) {
+        static atomic_flag logged = ATOMIC_FLAG_INIT;
+        if (!atomic_flag_test_and_set(&logged)) LOG("DiRT 3: received extended motion for adaptive triggers\n");
+    }
+    start_updates();
+    return true;
+}
diff --git a/src/dirt3_bluetooth_input.m b/src/dirt3_bluetooth_input.m
new file mode 100644
index 0000000..dd6d979
--- /dev/null
+++ b/src/dirt3_bluetooth_input.m
@@ -0,0 +1,113 @@
+// The Bluetooth DualSense streams extended report 0x31, but its standard
+// IOHID button elements belong to the descriptor's short report 0x01.
+// Feed DiRT 3's existing element callback from the extended report.
+#import <IOKit/hid/IOHIDLib.h>
+#import <IOKit/hid/IOHIDKeys.h>
+#include <mach/mach_time.h>
+#include "thunks.h"
+
+extern int dirt3_version_patch_active(void);
+
+enum { buttons = 14, axes = 6, controls = buttons + axes + 1 };
+static const uint8_t axis_usage[axes] = {48, 49, 50, 53, 51, 52};
+
+struct bluetooth_input {
+    IOHIDDeviceRef device;
+    CFArrayRef elements;
+    IOHIDElementRef control[controls];
+    int previous[controls];
+    bool initialized;
+};
+
+// IOHIDManager serializes report, matching and removal callbacks on the
+// same run loop as the game's normal input-value callbacks.
+static struct bluetooth_input input;
+
+static void clear(void)
+{
+    if (input.elements) CFRelease(input.elements);
+    if (input.device) CFRelease(input.device);
+    input = (struct bluetooth_input){0};
+}
+
+void dirt3_bluetooth_remove(IOHIDDeviceRef device)
+{
+    if (input.device == device) clear();
+}
+
+static bool is_bluetooth_dualsense(IOHIDDeviceRef device)
+{
+    CFTypeRef vendor = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDVendorIDKey));
+    CFTypeRef product = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDProductIDKey));
+    CFTypeRef transport = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDTransportKey));
+    int vendor_id = 0, product_id = 0;
+    return vendor && CFGetTypeID(vendor) == CFNumberGetTypeID() &&
+        CFNumberGetValue(vendor, kCFNumberIntType, &vendor_id) && vendor_id == 0x054c &&
+        product && CFGetTypeID(product) == CFNumberGetTypeID() &&
+        CFNumberGetValue(product, kCFNumberIntType, &product_id) && product_id == 0x0ce6 &&
+        transport && CFEqual(transport, CFSTR("Bluetooth"));
+}
+
+static bool bind_elements(IOHIDDeviceRef device)
+{
+    if (!is_bluetooth_dualsense(device)) return false;
+    clear();
+    input.device = (IOHIDDeviceRef)CFRetain(device);
+    input.elements = IOHIDDeviceCopyMatchingElements(device, NULL, kIOHIDOptionsTypeNone);
+    if (!input.elements) {
+        clear();
+        return false;
+    }
+    for (CFIndex i = 0, count = CFArrayGetCount(input.elements); i < count; i++) {
+        IOHIDElementRef element = (IOHIDElementRef)CFArrayGetValueAtIndex(input.elements, i);
+        if (IOHIDElementGetReportID(element) != 1) continue;
+        uint32_t page = IOHIDElementGetUsagePage(element), usage = IOHIDElementGetUsage(element);
+        if (page == 9 && usage >= 1 && usage <= buttons) {
+            input.control[usage - 1] = element;
+        } else if (page == 1) {
+            if (usage == 57) input.control[buttons + axes] = element;
+            for (size_t axis = 0; axis < axes; axis++)
+                if (usage == axis_usage[axis]) input.control[buttons + axis] = element;
+        }
+    }
+    LOG("DiRT 3: translating extended DualSense Bluetooth reports\n");
+    return true;
+}
+
+static void report(void *opaque, IOReturn result, void *sender, IOHIDReportType type,
+                   uint32_t report_id, uint8_t *bytes, CFIndex size)
+{
+    if (result != kIOReturnSuccess || type != kIOHIDReportTypeInput ||
+        report_id != 0x31 || size != 78 || !sender || bytes[0] != report_id ||
+        CFGetTypeID(sender) != IOHIDDeviceGetTypeID()) return;
+
+    IOHIDDeviceRef device = (IOHIDDeviceRef)sender;
+    if (input.device && input.device != device) return;
+    if (!input.device && !bind_elements(device)) return;
+
+    // 0x31 carries the six axes followed by a counter and the button groups.
+    uint16_t mask = (uint16_t)(bytes[9] >> 4) |
+                    ((uint16_t)bytes[10] << 4) | ((uint16_t)(bytes[11] & 3) << 12);
+    int current[controls];
+    for (size_t index = 0; index < buttons; index++) current[index] = (mask >> index) & 1;
+    for (size_t axis = 0; axis < axes; axis++) current[buttons + axis] = bytes[2 + axis];
+    current[buttons + axes] = (bytes[9] & 15) <= 8 ? bytes[9] & 15 : 8;
+
+    uint64_t refcon = (uintptr_t)opaque, time = mach_absolute_time();
+    for (size_t index = 0; index < controls; index++) {
+        if (!input.control[index] || (input.initialized && current[index] == input.previous[index])) continue;
+        IOHIDValueRef value = IOHIDValueCreateWithIntegerValue(NULL, input.control[index], time, current[index]);
+        if (!value) continue;
+        gcall((g32)(refcon >> 32), 4, (g32)refcon, (uint32_t)result, hobj_wrap(sender),
+              hobj_wrap((void *)value));
+        CFRelease(value);
+    }
+    memcpy(input.previous, current, sizeof(current));
+    input.initialized = true;
+}
+
+void dirt3_bluetooth_register(IOHIDManagerRef manager, void *refcon)
+{
+    if (!dirt3_version_patch_active()) return;
+    IOHIDManagerRegisterInputReportCallback(manager, refcon ? report : NULL, refcon);
+}
diff --git a/src/dirt3_force_feedback.m b/src/dirt3_force_feedback.m
new file mode 100644
index 0000000..968ca06
--- /dev/null
+++ b/src/dirt3_force_feedback.m
@@ -0,0 +1,598 @@
+// The i386 game sends two motor strengths through the old ForceFeedback API.
+// Translate only its DualSense gamepad path, keeping the controller's input
+// connection and any other legacy devices independent of this bridge.
+#import <AppKit/AppKit.h>
+#import <CoreHaptics/CoreHaptics.h>
+#import <ForceFeedback/ForceFeedback.h>
+#import <GameController/GameController.h>
+#import <IOKit/hid/IOHIDKeys.h>
+#include <math.h>
+#include <os/lock.h>
+#include <stdatomic.h>
+#include <time.h>
+#include "thunks.h"
+
+extern int dirt3_version_patch_active(void);
+extern void dirt3_adaptive_triggers_reset_idle_device(void);
+
+enum { max_devices = 4, max_effects = 12 };
+static const double output_watchdog = 0.35;
+static const double haptic_event_duration = 0.25;
+static os_unfair_lock state_lock = OS_UNFAIR_LOCK_INIT;
+static g32 next_handle = 1;
+static bool trace_enabled, trace_only;
+static _Thread_local float game_rumble_gain = -1;
+static double terminal_since, terminal_until;
+
+struct device {
+    g32 handle;
+    float gain, escape[2];
+    float game_rumble_gain;
+    double escape_end;
+};
+
+struct effect {
+    g32 handle, owner;
+    uint32_t channel, duration;
+    float strength, gain;
+    double end;
+};
+
+struct effect32 {
+    uint32_t size, flags, duration, sample_period, gain;
+    uint32_t trigger, repeat, axes, axis_list, directions, envelope;
+    uint32_t params_size;
+    g32 params;
+    uint32_t start_delay;
+};
+
+struct escape32 {
+    uint32_t size, command;
+    g32 input;
+    uint32_t input_size;
+    g32 output;
+    uint32_t output_size;
+};
+
+_Static_assert(sizeof(struct effect32) == 56, "32-bit FFEFFECT");
+_Static_assert(sizeof(struct escape32) == 24, "32-bit FFEFFESCAPE");
+_Static_assert(sizeof(FFCAPABILITIES) == 72, "FFCAPABILITIES uses fixed-size fields");
+_Static_assert(sizeof(FFPERIODIC) == 16, "FFPERIODIC uses fixed-size fields");
+
+static struct device devices[max_devices];
+static struct effect effects[max_effects];
+
+@interface Dirt3Motor : NSObject
+@property (retain) CHHapticEngine *engine;
+@property (retain) id<CHHapticPatternPlayer> player;
+@property float level;
+@property double renewAt;
+@end
+@implementation Dirt3Motor
+- (void)dealloc
+{
+    [_player release];
+    [_engine release];
+    [super dealloc];
+}
+@end
+
+// Core Haptics and controller identity are owned by the main-queue timer.
+static GCController *controller;
+static Dirt3Motor *motors[2];
+static double retry_at;
+static bool split_handles;
+static dispatch_source_t update_timer;
+
+static double now(void)
+{
+    return (double)clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1e9;
+}
+
+float dirt3_set_game_rumble_gain(float gain)
+{
+    float previous = game_rumble_gain;
+    game_rumble_gain = gain >= 0 && gain <= 1 ? gain : -1;
+    return previous;
+}
+
+void dirt3_terminal_slow_motion(bool active)
+{
+    double time = now();
+    os_unfair_lock_lock(&state_lock);
+    if (active) {
+        if (time >= terminal_until) {
+            terminal_since = time;
+            if (trace_enabled) LOG("DualSense terminal slow motion: started\n");
+        }
+        // Only the live slow-motion state renews the effect.
+        terminal_until = time + 0.25;
+    } else if (terminal_until > time) {
+        // Adjacent slow-motion states can exit and enter within one frame.
+        terminal_until = fmin(terminal_until, time + 0.045);
+    }
+    os_unfair_lock_unlock(&state_lock);
+}
+
+static float normalize(uint32_t value)
+{
+    return fminf(value, FF_FFNOMINALMAX) / FF_FFNOMINALMAX;
+}
+
+static struct device *find_device(g32 handle)
+{
+    for (size_t i = 0; handle && i < max_devices; ++i)
+        if (devices[i].handle == handle) return &devices[i];
+    return NULL;
+}
+
+static struct effect *find_effect(g32 handle)
+{
+    for (size_t i = 0; handle && i < max_effects; ++i)
+        if (effects[i].handle == handle) return &effects[i];
+    return NULL;
+}
+
+static void capture_game_rumble_gain(struct device *device)
+{
+    if (!device || game_rumble_gain < 0 || device->game_rumble_gain == game_rumble_gain) return;
+    device->game_rumble_gain = game_rumble_gain;
+    if (trace_enabled) LOG("DualSense force feedback: game effects gain %.2f\n", game_rumble_gain);
+}
+
+static void bind_cached_motors(void)
+{
+    g32 owner = 0;
+    for (size_t i = 0; i < max_devices; ++i) {
+        if (!devices[i].handle) continue;
+        if (owner) return;
+        owner = devices[i].handle;
+    }
+    if (!owner) return;
+    for (size_t i = 0; i < max_effects; ++i) {
+        if (!effects[i].handle || effects[i].owner) continue;
+        effects[i].owner = owner;
+        if (trace_enabled)
+            LOG("DualSense force feedback: rebound motor %u to device %u\n", effects[i].channel, owner);
+    }
+}
+
+static bool is_dualsense_service(io_service_t service)
+{
+    if (!service || !dirt3_version_patch_active()) return false;
+    CFTypeRef vendor = IORegistryEntryCreateCFProperty(service, CFSTR(kIOHIDVendorIDKey), NULL, 0);
+    CFTypeRef product = IORegistryEntryCreateCFProperty(service, CFSTR(kIOHIDProductIDKey), NULL, 0);
+    bool matches = vendor && product && CFEqual(vendor, (CFTypeRef)@0x054c) &&
+                   CFEqual(product, (CFTypeRef)@0x0ce6);
+    if (vendor) CFRelease(vendor);
+    if (product) CFRelease(product);
+    return matches;
+}
+
+static GCController *one_connected_dualsense(void)
+{
+    GCController *match = nil;
+    for (GCController *candidate in GCController.controllers) {
+        if (![candidate.extendedGamepad isKindOfClass:[GCDualSenseGamepad class]]) continue;
+        // The public framework does not expose the IORegistry identity. Avoid
+        // applying effects to the wrong controller when there are two.
+        if (match) return nil;
+        match = candidate;
+    }
+    return match;
+}
+
+static void reset_motors(void)
+{
+    for (size_t i = 0; i < 2; ++i) {
+        [motors[i].player stopAtTime:CHHapticTimeImmediate error:nil];
+        [motors[i].engine stopWithCompletionHandler:nil];
+        [motors[i] release];
+        motors[i] = nil;
+    }
+}
+
+static Dirt3Motor *create_motor(GCHapticsLocality locality, float sharpness)
+{
+    Dirt3Motor *motor = [[Dirt3Motor alloc] init];
+    motor.engine = [controller.haptics createEngineWithLocality:locality];
+    if (!motor.engine) { [motor release]; return nil; }
+    motor.engine.playsHapticsOnly = YES;
+    NSError *error = nil;
+    if (![motor.engine startAndReturnError:&error]) {
+        LOG("DualSense haptic engine start failed: %s (%ld)\n",
+            error.localizedDescription.UTF8String ?: "unknown error", (long)error.code);
+        [motor release];
+        return nil;
+    }
+    CHHapticEventParameter *tone = [[[CHHapticEventParameter alloc]
+        initWithParameterID:CHHapticEventParameterIDHapticSharpness value:sharpness] autorelease];
+    CHHapticEventParameter *intensity = [[[CHHapticEventParameter alloc]
+        initWithParameterID:CHHapticEventParameterIDHapticIntensity value:1.0f] autorelease];
+    CHHapticEvent *event = [[[CHHapticEvent alloc]
+        initWithEventType:CHHapticEventTypeHapticContinuous parameters:@[intensity, tone]
+        relativeTime:0 duration:haptic_event_duration] autorelease];
+    CHHapticPattern *pattern = [[[CHHapticPattern alloc] initWithEvents:@[event]
+        parameters:@[] error:&error] autorelease];
+    // Controller haptic daemons can reject advanced players. The basic
+    // player supports both finite events and dynamic intensity changes.
+    if (pattern) motor.player = [motor.engine createPlayerWithPattern:pattern error:&error];
+    if (!motor.player) {
+        [motor.engine stopWithCompletionHandler:nil];
+        LOG("DualSense haptic player creation failed: %s (%ld)\n",
+            error.localizedDescription.UTF8String ?: "unknown error", (long)error.code);
+        [motor release];
+        return nil;
+    }
+    return motor;
+}
+
+static bool set_motor(Dirt3Motor *motor, float strength, double time)
+{
+    if (!motor) return true;
+    strength = roundf(strength * 255.0f) / 255.0f;
+    if (strength == 0) {
+        if (motor.level != 0) [motor.player stopAtTime:CHHapticTimeImmediate error:nil];
+        motor.level = 0;
+        return true;
+    }
+    bool restart = !motor.level || time >= motor.renewAt;
+    if (!restart && motor.level == strength) return true;
+    CHHapticDynamicParameter *intensity = [[[CHHapticDynamicParameter alloc]
+        initWithParameterID:CHHapticDynamicParameterIDHapticIntensityControl
+        value:strength relativeTime:0] autorelease];
+    NSError *error = nil;
+    if ((restart && ![motor.player startAtTime:CHHapticTimeImmediate error:&error]) ||
+        ![motor.player sendParameters:@[intensity] atTime:CHHapticTimeImmediate error:&error]) {
+        LOG("DualSense haptics stopped: %s\n", error.localizedDescription.UTF8String ?: "player failed");
+        return false;
+    }
+    if (restart) motor.renewAt = time + haptic_event_duration;
+    motor.level = strength;
+    return true;
+}
+
+static void update_motors(void)
+{
+    @autoreleasepool {
+        double time = now();
+        float strength[2] = {0, 0};
+        float terminal_gain = 0;
+        bool has_device = false;
+        os_unfair_lock_lock(&state_lock);
+        for (size_t i = 0; i < max_devices; ++i) {
+            struct device *device = &devices[i];
+            if (!device->handle) continue;
+            has_device = true;
+            terminal_gain = fmaxf(terminal_gain, device->game_rumble_gain * device->gain);
+            if (device->escape_end > time)
+                for (size_t channel = 0; channel < 2; ++channel)
+                    strength[channel] = fmaxf(strength[channel], device->escape[channel] * device->gain);
+        }
+        for (size_t i = 0; i < max_effects; ++i) {
+            struct effect *effect = &effects[i];
+            struct device *device = effect->end > time ? find_device(effect->owner) : NULL;
+            if (device)
+                strength[effect->channel] = fmaxf(strength[effect->channel], effect->strength * effect->gain * device->gain);
+        }
+        if (has_device && time < terminal_until) {
+            float elapsed = (float)fmax(0, time - terminal_since);
+            float shake = (0.245f + 0.64f * expf(-2.7f * elapsed)) * terminal_gain;
+            strength[0] = fmaxf(strength[0], shake);
+            strength[1] = fmaxf(strength[1], shake * 0.88f);
+        } else if (terminal_since && time >= terminal_until) {
+            if (trace_enabled) LOG("DualSense terminal slow motion: ended after %.2f s\n",
+                terminal_until - terminal_since);
+            terminal_since = 0;
+        }
+        os_unfair_lock_unlock(&state_lock);
+        if (!has_device) {
+            reset_motors();
+            [controller release];
+            controller = nil;
+            dispatch_source_cancel(update_timer);
+            dispatch_release(update_timer);
+            update_timer = NULL;
+            return;
+        }
+
+        static bool traced_output;
+        static double trace_at;
+        bool rumbling = strength[0] > 0 || strength[1] > 0;
+        if (trace_enabled && rumbling && (!traced_output || time >= trace_at)) {
+            LOG("DualSense force feedback: left=%.3f right=%.3f\n", strength[0], strength[1]);
+            trace_at = time + 1;
+        }
+        traced_output = rumbling;
+        if (trace_only) return;
+
+        GCController *connected = NSApp.isActive && (rumbling || controller)
+            ? one_connected_dualsense() : nil;
+        if (connected != controller) {
+            reset_motors();
+            [controller release];
+            controller = [connected retain];
+            retry_at = 0;
+        }
+        if (!controller) return;
+        if (rumbling && !motors[0] && time >= retry_at) {
+            NSSet *locations = controller.haptics.supportedLocalities;
+            split_handles = [locations containsObject:GCHapticsLocalityLeftHandle] &&
+                            [locations containsObject:GCHapticsLocalityRightHandle];
+            if (split_handles) {
+                motors[0] = create_motor(GCHapticsLocalityLeftHandle, 0.25f);
+                motors[1] = create_motor(GCHapticsLocalityRightHandle, 0.75f);
+                if (!motors[0] || !motors[1]) { reset_motors(); split_handles = false; }
+            }
+            if (!split_handles && locations.count)
+                motors[0] = create_motor(GCHapticsLocalityDefault, 0.5f);
+            if (motors[0])
+                LOG("DualSense haptics ready (%s)\n", split_handles ? "two handles" : "combined handles");
+            retry_at = time + 2;
+        }
+
+        float first = split_handles ? strength[0] : fmaxf(strength[0], strength[1]);
+        if (!set_motor(motors[0], first, time) || !set_motor(motors[1], strength[1], time)) {
+            reset_motors();
+            retry_at = time + 2;
+        }
+    }
+}
+
+static void start_timer(void)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (update_timer) return;
+        update_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+        dispatch_source_set_timer(update_timer, DISPATCH_TIME_NOW, NSEC_PER_SEC / 40, NSEC_PER_MSEC * 3);
+        dispatch_source_set_event_handler(update_timer, ^{ update_motors(); });
+        dispatch_activate(update_timer);
+    });
+}
+
+static void t_ff_supported(uint32_t *args, struct hres *r)
+{
+    bool supported = is_dualsense_service(A(0));
+    if (trace_enabled) LOG("DualSense force feedback: legacy service matched=%d\n", supported);
+    RET(supported ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_create_device(uint32_t *args, struct hres *r)
+{
+    g32 *out = G2H(A(1));
+    if (!out) { RET(FFERR_INVALIDPARAM); return; }
+    *out = 0;
+    if (!is_dualsense_service(A(0))) { RET(FFERR_NOINTERFACE); return; }
+
+    os_unfair_lock_lock(&state_lock);
+    for (size_t i = 0; i < max_devices; ++i) {
+        if (devices[i].handle) continue;
+        devices[i] = (struct device){.handle = next_handle++, .gain = 1};
+        *out = devices[i].handle;
+        break;
+    }
+    if (*out) bind_cached_motors();
+    os_unfair_lock_unlock(&state_lock);
+    if (*out) {
+        if (trace_enabled) LOG("DualSense force feedback: legacy device created\n");
+        dirt3_adaptive_triggers_reset_idle_device();
+        start_timer();
+    }
+    RET(*out ? FF_OK : FFERR_DEVICEFULL);
+}
+
+static void t_ff_release_device(uint32_t *args, struct hres *r)
+{
+    os_unfair_lock_lock(&state_lock);
+    struct device *device = find_device(A(0));
+    if (device) {
+        *device = (struct device){0};
+        for (size_t i = 0; i < max_effects; ++i) {
+            struct effect *effect = &effects[i];
+            if (effect->owner != A(0)) continue;
+            if (effect->duration != FF_INFINITE) {
+                *effect = (struct effect){0};
+                continue;
+            }
+            // DiRT 3 keeps its two infinite rumble effect handles in globals
+            // and reuses them across device removal and arrival callbacks.
+            effect->owner = 0;
+            effect->end = 0;
+            effect->strength = 0;
+        }
+        bind_cached_motors();
+        if (trace_enabled) LOG("DualSense force feedback: released device %u\n", A(0));
+    }
+    os_unfair_lock_unlock(&state_lock);
+    RET(device ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static bool parse_periodic(const struct effect32 *definition, struct effect *effect)
+{
+    if (definition->size != sizeof(*definition) || definition->params_size != sizeof(FFPERIODIC) ||
+        !definition->params) return false;
+    const FFPERIODIC *periodic = G2H(definition->params);
+    if (periodic->dwPeriod != 500000 && periodic->dwPeriod != 250000) return false;
+    effect->channel = periodic->dwPeriod == 250000;
+    effect->strength = normalize(periodic->dwMagnitude);
+    return true;
+}
+
+static void t_ff_create_effect(uint32_t *args, struct hres *r)
+{
+    const struct effect32 *definition = G2H(A(2));
+    g32 *out = G2H(A(3));
+    CFUUIDRef type = hobj_unwrap(A(1));
+    if (!out) { RET(FFERR_INVALIDPARAM); return; }
+    *out = 0;
+    struct effect effect = {.owner = A(0)};
+    if (!type || !CFEqual(type, kFFEffectType_Sine_ID) || !definition || !parse_periodic(definition, &effect)) {
+        static atomic_flag logged = ATOMIC_FLAG_INIT;
+        if (trace_enabled && !atomic_flag_test_and_set_explicit(&logged, memory_order_relaxed))
+            LOG("DualSense force feedback: unsupported legacy effect\n");
+        RET(FFERR_UNSUPPORTED);
+        return;
+    }
+    effect.duration = definition->duration;
+    effect.gain = normalize(definition->gain);
+
+    os_unfair_lock_lock(&state_lock);
+    bool valid_owner = find_device(effect.owner) != NULL;
+    if (valid_owner) {
+        for (size_t i = 0; i < max_effects; ++i) {
+            if (effects[i].handle) continue;
+            effect.handle = next_handle++;
+            effects[i] = effect;
+            *out = effect.handle;
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&state_lock);
+    if (*out && trace_enabled)
+        LOG("DualSense force feedback: game created motor %u (%.3f)\n", effect.channel, effect.strength);
+    RET(!valid_owner ? FFERR_NOINTERFACE : *out ? FF_OK : FFERR_DEVICEFULL);
+}
+
+static double playback_end(const struct effect *effect, uint32_t iterations)
+{
+    return now() + fmin(output_watchdog, iterations * (effect->duration / 1e6));
+}
+
+static void t_ff_set_effect(uint32_t *args, struct hres *r)
+{
+    const struct effect32 *definition = G2H(A(1));
+    uint32_t flags = A(2);
+    if (!definition || definition->size != sizeof(*definition)) { RET(FFERR_INVALIDPARAM); return; }
+    os_unfair_lock_lock(&state_lock);
+    struct effect *effect = find_effect(A(0));
+    bool valid = effect && effect->owner && (!(flags & FFEP_TYPESPECIFICPARAMS) || parse_periodic(definition, effect));
+    if (valid) {
+        capture_game_rumble_gain(find_device(effect->owner));
+        if (flags & FFEP_GAIN) effect->gain = normalize(definition->gain);
+        if (flags & FFEP_DURATION) effect->duration = definition->duration;
+        if (flags & FFEP_START) effect->end = playback_end(effect, 1);
+    }
+    os_unfair_lock_unlock(&state_lock);
+    RET(valid ? FF_OK : FFERR_INVALIDPARAM);
+}
+
+static void t_ff_start_effect(uint32_t *args, struct hres *r)
+{
+    os_unfair_lock_lock(&state_lock);
+    struct effect *effect = find_effect(A(0));
+    bool valid = effect && effect->owner;
+    if (valid) effect->end = playback_end(effect, A(1));
+    os_unfair_lock_unlock(&state_lock);
+    RET(valid ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_stop_effect(uint32_t *args, struct hres *r)
+{
+    os_unfair_lock_lock(&state_lock);
+    struct effect *effect = find_effect(A(0));
+    if (effect) effect->end = 0;
+    os_unfair_lock_unlock(&state_lock);
+    RET(effect ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_effect_status(uint32_t *args, struct hres *r)
+{
+    uint32_t *status = G2H(A(1));
+    if (!status) { RET(FFERR_INVALIDPARAM); return; }
+    os_unfair_lock_lock(&state_lock);
+    struct effect *effect = find_effect(A(0));
+    *status = effect ? FFEGES_EMULATED | (effect->end > now() ? FFEGES_PLAYING : 0) : 0;
+    os_unfair_lock_unlock(&state_lock);
+    RET(effect ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_download_effect(uint32_t *args, struct hres *r)
+{
+    os_unfair_lock_lock(&state_lock);
+    bool valid = find_effect(A(0)) != NULL;
+    os_unfair_lock_unlock(&state_lock);
+    RET(valid ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_release_effect(uint32_t *args, struct hres *r)
+{
+    os_unfair_lock_lock(&state_lock);
+    struct effect *effect = find_effect(A(1));
+    bool valid = effect && effect->owner == A(0);
+    if (valid) *effect = (struct effect){0};
+    os_unfair_lock_unlock(&state_lock);
+    RET(valid ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_capabilities(uint32_t *args, struct hres *r)
+{
+    FFCAPABILITIES *out = G2H(A(1));
+    if (!out) { RET(FFERR_INVALIDPARAM); return; }
+    os_unfair_lock_lock(&state_lock);
+    bool valid = find_device(A(0)) != NULL;
+    os_unfair_lock_unlock(&state_lock);
+    if (valid) *out = (FFCAPABILITIES){
+        .supportedEffects = FFCAP_ET_SINE, .emulatedEffects = FFCAP_ET_SINE,
+        .subType = FFCAP_ST_VIBRATION, .storageCapacity = max_effects, .playbackCapacity = 2,
+    };
+    RET(valid ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_set_property(uint32_t *args, struct hres *r)
+{
+    if (A(1) != FFPROP_FFGAIN || !A(2)) { RET(FFERR_UNSUPPORTED); return; }
+    os_unfair_lock_lock(&state_lock);
+    struct device *device = find_device(A(0));
+    if (device) device->gain = normalize(*(const uint32_t *)G2H(A(2)));
+    os_unfair_lock_unlock(&state_lock);
+    RET(device ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static void t_ff_escape(uint32_t *args, struct hres *r)
+{
+    const struct escape32 *command = G2H(A(1));
+    if (!command || command->size != sizeof(*command) || !command->input || command->output_size) {
+        RET(FFERR_INVALIDPARAM);
+        return;
+    }
+    const uint8_t *input = G2H(command->input);
+    bool enable = command->command == 0 && command->input_size == 1 && input[0] <= 1;
+    bool motors_update = command->command == 1 && command->input_size == 2;
+    if (!enable && !motors_update) { RET(FFERR_UNSUPPORTED); return; }
+
+    os_unfair_lock_lock(&state_lock);
+    struct device *device = find_device(A(0));
+    if (device && motors_update) {
+        capture_game_rumble_gain(device);
+        device->escape[0] = input[0] / 255.0f;
+        device->escape[1] = input[1] / 255.0f;
+        device->escape_end = now() + output_watchdog;
+    } else if (device && input[0] == 0) {
+        device->escape_end = 0;
+    }
+    os_unfair_lock_unlock(&state_lock);
+    RET(device ? FF_OK : FFERR_NOINTERFACE);
+}
+
+static struct hfn feedback[] = {
+    R("_FFIsForceFeedback", t_ff_supported),
+    R("_FFCreateDevice", t_ff_create_device),
+    R("_FFReleaseDevice", t_ff_release_device),
+    R("_FFDeviceCreateEffect", t_ff_create_effect),
+    R("_FFDeviceReleaseEffect", t_ff_release_effect),
+    R("_FFDeviceGetForceFeedbackCapabilities", t_ff_capabilities),
+    R("_FFDeviceSetForceFeedbackProperty", t_ff_set_property),
+    R("_FFDeviceEscape", t_ff_escape),
+    R("_FFEffectDownload", t_ff_download_effect),
+    R("_FFEffectGetEffectStatus", t_ff_effect_status),
+    R("_FFEffectSetParameters", t_ff_set_effect),
+    R("_FFEffectStart", t_ff_start_effect),
+    R("_FFEffectStop", t_ff_stop_effect),
+};
+
+void thunks_dirt3_force_feedback_init(void)
+{
+    trace_only = getenv("MAC32_DUALSENSE_FF_TRACE_ONLY") != NULL;
+    trace_enabled = trace_only || getenv("MAC32_TRACE_DUALSENSE_FF") != NULL;
+    REGISTER(feedback);
+}
diff --git a/src/dirt3_input.m b/src/dirt3_input.m
new file mode 100644
index 0000000..7149d5b
--- /dev/null
+++ b/src/dirt3_input.m
@@ -0,0 +1,121 @@
+#import <Foundation/Foundation.h>
+#include "thunks.h"
+
+extern void *guest_main_cfbundle(void);
+
+static NSURL *input_workspace;
+static const int sony_vendor_id = 0x054c;
+static const int dualsense_product_id = 0x0ce6;
+
+static BOOL is_sony_profile(NSDictionary *profile, int product_id)
+{
+	return [profile[@"VendorID"] isEqual:@(sony_vendor_id)] &&
+		[profile[@"ProductID"] isEqual:@(product_id)];
+}
+
+static void remove_input_workspace(void)
+{
+	@autoreleasepool {
+		[[NSFileManager defaultManager] removeItemAtURL:input_workspace error:NULL];
+		[input_workspace release];
+	}
+}
+
+static BOOL stage_input_directory(NSURL *original, NSURL *staged, NSFileManager *files)
+{
+	// Build the new directories with local permissions so a read-only game
+	// installation can still use and clean up its private copy.
+	if (![files createDirectoryAtURL:staged withIntermediateDirectories:NO attributes:nil error:NULL])
+		return NO;
+
+	NSArray<NSURL *> *entries = [files contentsOfDirectoryAtURL:original
+		includingPropertiesForKeys:@[NSURLIsDirectoryKey, NSURLIsSymbolicLinkKey]
+		options:0 error:NULL];
+	if (!entries)
+		return NO;
+	for (NSURL *entry in entries) {
+		NSNumber *is_directory, *is_symlink;
+		if (![entry getResourceValue:&is_directory forKey:NSURLIsDirectoryKey error:NULL] ||
+			![entry getResourceValue:&is_symlink forKey:NSURLIsSymbolicLinkKey error:NULL])
+			return NO;
+		NSURL *destination = [staged URLByAppendingPathComponent:entry.lastPathComponent];
+		BOOL copied = is_directory.boolValue && !is_symlink.boolValue ?
+			stage_input_directory(entry, destination, files) :
+			[files copyItemAtURL:entry toURL:destination error:NULL];
+		if (!copied)
+			return NO;
+	}
+	return YES;
+}
+
+static NSURL *copy_input_directory_with_dualsense(NSURL *original)
+{
+	NSFileManager *files = [NSFileManager defaultManager];
+	NSMutableDictionary *profile = [NSMutableDictionary dictionaryWithContentsOfURL:
+		[original URLByAppendingPathComponent:@"AnalogTriggers/PS4Dualshock.plist"]];
+	if (!is_sony_profile(profile, 0x05c4))
+		return nil;
+
+	// Keep a caller's own controller profiles authoritative, regardless of filename.
+	for (NSURL *entry in [files enumeratorAtURL:original includingPropertiesForKeys:nil
+		options:NSDirectoryEnumerationSkipsHiddenFiles errorHandler:nil]) {
+		if ([entry.pathExtension isEqualToString:@"plist"] &&
+			is_sony_profile([NSDictionary dictionaryWithContentsOfURL:entry], dualsense_product_id))
+			return nil;
+	}
+
+	NSString *template = [NSTemporaryDirectory() stringByAppendingPathComponent:@"mac32-dirt3-input.XXXXXX"];
+	char *path = strdup(template.fileSystemRepresentation);
+	if (!path)
+		return nil;
+	NSURL *workspace = nil;
+	if (mkdtemp(path))
+		workspace = [NSURL fileURLWithFileSystemRepresentation:path isDirectory:YES relativeToURL:nil];
+	free(path);
+	if (!workspace)
+		return nil;
+
+	// The game enumerates the controller directory by path. Stage only that
+	// resource instead of changing the installed bundle or copying the game.
+	NSURL *staged = [workspace URLByAppendingPathComponent:@"InputDevices" isDirectory:YES];
+	profile[@"ProductID"] = @(dualsense_product_id);
+	profile[@"CGPDisplayNameOvr"] = @"DualSense";
+	profile[@"ButtonBack"] = @"9:9";
+	NSURL *destination = [staged URLByAppendingPathComponent:@"AnalogTriggers/DualSense.plist"];
+	if (!stage_input_directory(original, staged, files) ||
+		![profile writeToURL:destination atomically:YES] ||
+		atexit(remove_input_workspace) != 0) {
+		[files removeItemAtURL:workspace error:NULL];
+		return nil;
+	}
+
+	input_workspace = [workspace retain];
+	LOG("DiRT 3: added the DualSense controller profile\n");
+	return [staged retain];
+}
+
+CFURLRef w_CFBundleCopyResourceURL(CFBundleRef bundle, CFStringRef name, CFStringRef type,
+	CFStringRef directory)
+{
+	CFURLRef original = CFBundleCopyResourceURL(bundle, name, type, directory);
+	if (!original || !name || !CFEqual(name, CFSTR("InputDevices")) ||
+		(type && CFStringGetLength(type)) || (directory && CFStringGetLength(directory)) ||
+		bundle != guest_main_cfbundle())
+		return original;
+
+	CFStringRef identifier = CFBundleGetIdentifier(bundle);
+	if (!identifier || !CFEqual(identifier, CFSTR("com.feralinteractive.dirt3")))
+		return original;
+
+	static dispatch_once_t once;
+	static NSURL *staged;
+	dispatch_once(&once, ^{
+		@autoreleasepool {
+			staged = copy_input_directory_with_dualsense((__bridge NSURL *)original);
+		}
+	});
+	if (!staged)
+		return original;
+	CFRelease(original);
+	return (CFURLRef)CFRetain((__bridge CFURLRef)staged);
+}
diff --git a/src/dirt3_overlay.m b/src/dirt3_overlay.m
new file mode 100644
index 0000000..a7d4b29
--- /dev/null
+++ b/src/dirt3_overlay.m
@@ -0,0 +1,321 @@
+#import <AppKit/AppKit.h>
+#import <Carbon/Carbon.h>
+#import <IOKit/IOKitLib.h>
+#import <OpenGL/OpenGL.h>
+#include <math.h>
+#include <os/lock.h>
+#include <stdatomic.h>
+#include <sys/resource.h>
+#include <time.h>
+#include "mac32.h"
+
+extern int dirt3_version_patch_active(void);
+
+enum { frame_capacity = 2048, cpu_history_capacity = 5 };
+struct frame_sample { uint64_t end, elapsed; };
+static const uint64_t history_ns = 5 * NSEC_PER_SEC;
+static const uint64_t no_present_ns = NSEC_PER_SEC;
+
+static atomic_bool monitor_installed;
+static atomic_bool recording;
+static os_unfair_lock frame_lock = OS_UNFAIR_LOCK_INIT;
+static struct {
+	CGLContextObj context;
+	uint64_t last_present;
+	uint64_t presented;
+	size_t next, count;
+	struct frame_sample history[frame_capacity];
+} frames;
+
+// The display code lives on the main thread. Only the small timing ring is
+// shared with the render thread.
+static NSPanel *panel;
+static NSTextField *text;
+static NSTimer *refresh_timer;
+static id key_monitor;
+static io_service_t gpu;
+static uint64_t last_poll, last_cpu_time, last_cpu_frames;
+static double cpu_percent, cpu_ms;
+static unsigned cpu_min_cores;
+static struct { uint64_t end; unsigned cores; } cpu_history[cpu_history_capacity];
+static size_t next_cpu_sample;
+static struct gpu_sample { int device, renderer, tiler; } gpu_usage;
+
+static void set_recording(bool on)
+{
+	if (atomic_load_explicit(&recording, memory_order_relaxed) == on) return;
+	os_unfair_lock_lock(&frame_lock);
+	atomic_store_explicit(&recording, on, memory_order_relaxed);
+	frames.context = NULL;
+	frames.last_present = 0;
+	frames.count = frames.next = 0;
+	os_unfair_lock_unlock(&frame_lock);
+	last_poll = 0;
+	memset(cpu_history, 0, sizeof(cpu_history));
+	next_cpu_sample = 0;
+	cpu_percent = cpu_ms = -1;
+}
+
+static void record_present(CGLContextObj context)
+{
+	os_unfair_lock_lock(&frame_lock);
+	if (atomic_load_explicit(&recording, memory_order_relaxed)) {
+		uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+		uint64_t elapsed = now - frames.last_present;
+		if (frames.context == context && frames.last_present) {
+			if (elapsed && elapsed < history_ns) {
+				frames.history[frames.next] = (struct frame_sample){now, elapsed};
+				frames.next = (frames.next + 1) % frame_capacity;
+				if (frames.count < frame_capacity) frames.count++;
+			}
+		} else if (elapsed >= no_present_ns) {
+			// Select one drawable to avoid counting additional GL contexts
+			// twice. Allow a new context after the game recreates its window.
+			frames.context = context;
+			frames.count = frames.next = 0;
+		}
+		if (frames.context == context) {
+			frames.last_present = now;
+			frames.presented++;
+		}
+	}
+	os_unfair_lock_unlock(&frame_lock);
+}
+
+static int compare_slowest_first(const void *a, const void *b)
+{
+	uint64_t left = *(const uint64_t *)a, right = *(const uint64_t *)b;
+	return (right > left) - (right < left);
+}
+
+static uint64_t cpu_time_ns(void)
+{
+	struct rusage usage;
+	if (getrusage(RUSAGE_SELF, &usage) != 0) return 0;
+	return (uint64_t)(usage.ru_utime.tv_sec + usage.ru_stime.tv_sec) * NSEC_PER_SEC +
+		(uint64_t)(usage.ru_utime.tv_usec + usage.ru_stime.tv_usec) * NSEC_PER_USEC;
+}
+
+static unsigned minimum_cpu_cores(uint64_t now, double busy_cores)
+{
+	// A second of CPU time per second of wall time is one fully busy core.
+	// This only bounds the number of cores: the scheduler can move threads
+	// between cores. Retain the busiest sample for the frame history window.
+	// Ignore tiny overshoots at integer boundaries from sampling CPU and wall
+	// time separately (10 ms CPU time per second of wall time).
+	unsigned cores = MAX(1.0, ceil(busy_cores - 0.01));
+	cpu_history[next_cpu_sample].end = now;
+	cpu_history[next_cpu_sample].cores = cores;
+	next_cpu_sample = (next_cpu_sample + 1) % cpu_history_capacity;
+	for (size_t i = 0; i < cpu_history_capacity; i++) {
+		if (now - cpu_history[i].end < history_ns)
+			cores = MAX(cores, cpu_history[i].cores);
+	}
+	return cores;
+}
+
+static int gpu_counter(CFDictionaryRef stats, CFStringRef key)
+{
+	CFTypeRef value = CFDictionaryGetValue(stats, key);
+	int percent;
+	if (value && CFGetTypeID(value) == CFNumberGetTypeID() &&
+		CFNumberGetValue(value, kCFNumberIntType, &percent) && percent >= 0 && percent <= 100)
+		return percent;
+	return -1;
+}
+
+static struct gpu_sample gpu_utilization(void)
+{
+	struct gpu_sample sample = {-1, -1, -1};
+	if (!gpu) return sample;
+	CFTypeRef stats = IORegistryEntryCreateCFProperty(gpu, CFSTR("PerformanceStatistics"), NULL, 0);
+	if (stats && CFGetTypeID(stats) == CFDictionaryGetTypeID()) {
+		sample.device = gpu_counter(stats, CFSTR("Device Utilization %"));
+		sample.renderer = gpu_counter(stats, CFSTR("Renderer Utilization %"));
+		sample.tiler = gpu_counter(stats, CFSTR("Tiler Utilization %"));
+	}
+	if (stats) CFRelease(stats);
+	return sample;
+}
+
+static NSString *thermal_state(void)
+{
+	switch ([NSProcessInfo processInfo].thermalState) {
+	case NSProcessInfoThermalStateNominal: return @"Normal";
+	case NSProcessInfoThermalStateFair: return @"Elevated";
+	case NSProcessInfoThermalStateSerious: return @"High";
+	case NSProcessInfoThermalStateCritical: return @"Critical";
+	}
+	return @"—";
+}
+
+static void suspend_overlay(void)
+{
+	[panel.parentWindow removeChildWindow:panel];
+	[panel orderOut:nil];
+	set_recording(false);
+}
+
+static void refresh_overlay(void)
+{
+	NSWindow *game = NSApp.keyWindow ?: NSApp.mainWindow;
+	if (!NSApp.active || NSApp.modalWindow || game.isSheet || game.attachedSheet ||
+		!game.visible || game.miniaturized || !game.contentView) {
+		suspend_overlay();
+		return;
+	}
+
+	set_recording(true);
+	NSRect bounds = [game convertRectToScreen:game.contentLayoutRect];
+	NSRect frame = panel.frame;
+	NSPoint origin = NSMakePoint(NSMinX(bounds) + 12, NSMinY(bounds) + 12);
+	if (!NSEqualPoints(frame.origin, origin)) [panel setFrameOrigin:origin];
+	if (panel.parentWindow != game) {
+		[panel.parentWindow removeChildWindow:panel];
+		[game addChildWindow:panel ordered:NSWindowAbove];
+	}
+	if (!panel.visible) [panel orderFront:nil];
+
+	uint64_t times[frame_capacity];
+	uint64_t total_time = 0;
+	size_t count = 0;
+	os_unfair_lock_lock(&frame_lock);
+	uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+	uint64_t presented = frames.presented;
+	if (now - frames.last_present < no_present_ns) {
+		for (size_t i = 0; i < frames.count; i++) {
+			size_t index = (frames.next + frame_capacity - 1 - i) % frame_capacity;
+			if (now - frames.history[index].end >= history_ns) break;
+			times[count++] = frames.history[index].elapsed;
+			total_time += frames.history[index].elapsed;
+		}
+	}
+	os_unfair_lock_unlock(&frame_lock);
+
+	if (!last_poll || now - last_poll >= NSEC_PER_SEC) {
+		uint64_t spent = cpu_time_ns();
+		uint64_t elapsed = now - last_poll;
+		if (last_poll && spent && last_cpu_time && spent >= last_cpu_time &&
+			elapsed <= history_ns && count && presented > last_cpu_frames) {
+			uint64_t delta = spent - last_cpu_time;
+			double busy_cores = (double)delta / elapsed;
+			cpu_min_cores = minimum_cpu_cores(now, busy_cores);
+			cpu_percent = MIN(100.0, 100.0 * busy_cores / cpu_min_cores);
+			cpu_ms = (double)delta / (presented - last_cpu_frames) / NSEC_PER_MSEC;
+		} else {
+			cpu_percent = cpu_ms = -1;
+		}
+		last_poll = now;
+		last_cpu_time = spent;
+		last_cpu_frames = presented;
+		gpu_usage = gpu_utilization();
+	}
+
+	NSString *rate = @"Collecting frame timings…";
+	NSString *low = @"1% low       —";
+	if (count) {
+		rate = [NSString stringWithFormat:@"%5.1f FPS  /  %4.1f ms",
+			(double)NSEC_PER_SEC * count / total_time, (double)total_time / count / NSEC_PER_MSEC];
+	}
+	if (count >= 100) {
+		qsort(times, count, sizeof(times[0]), compare_slowest_first);
+		size_t slow_count = (count + 99) / 100;
+		uint64_t slow_time = 0;
+		for (size_t i = 0; i < slow_count; i++) slow_time += times[i];
+		low = [NSString stringWithFormat:@"1%% low    %5.1f FPS", (double)NSEC_PER_SEC * slow_count / slow_time];
+	}
+	NSString *cpu = cpu_percent >= 0 && count ? [NSString stringWithFormat:@"CPU %3.0f%% · ≥%u cores · %.1f ms",
+		cpu_percent, cpu_min_cores, cpu_ms] : @"CPU          —";
+	NSMutableString *device = [NSMutableString stringWithString:@"GPU sys "];
+	if (gpu_usage.device >= 0) [device appendFormat:@"%d%%", gpu_usage.device];
+	else [device appendString:@"—"];
+	if (gpu_usage.renderer >= 0) [device appendFormat:@" · R %d%%", gpu_usage.renderer];
+	if (gpu_usage.tiler >= 0) [device appendFormat:@" · T %d%%", gpu_usage.tiler];
+	text.stringValue = [NSString stringWithFormat:@"%@\n%@\n%@\n%@\nThermal      %@",
+		rate, low, cpu, device, thermal_state()];
+}
+
+static void hide_overlay(void)
+{
+	[refresh_timer invalidate];
+	refresh_timer = nil;
+	suspend_overlay();
+	if (gpu) IOObjectRelease(gpu);
+	gpu = IO_OBJECT_NULL;
+}
+
+static void toggle_overlay(void)
+{
+	if (refresh_timer) {
+		hide_overlay();
+		LOG("DiRT 3 performance overlay hidden\n");
+		return;
+	}
+
+	if (!panel) {
+		panel = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, 294, 104)
+			styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel
+			backing:NSBackingStoreBuffered defer:NO];
+		panel.title = @"Performance";
+		panel.collectionBehavior = NSWindowCollectionBehaviorFullScreenAuxiliary;
+		panel.excludedFromWindowsMenu = YES;
+		panel.hidesOnDeactivate = YES;
+		panel.ignoresMouseEvents = YES;
+		panel.opaque = NO;
+		panel.backgroundColor = [NSColor colorWithWhite:0.06 alpha:0.89];
+		text = [[NSTextField wrappingLabelWithString:@""] retain];
+		text.frame = NSInsetRect(panel.contentView.bounds, 10, 8);
+		text.font = [NSFont monospacedSystemFontOfSize:13 weight:NSFontWeightMedium];
+		text.textColor = [NSColor whiteColor];
+		text.maximumNumberOfLines = 5;
+		text.lineBreakMode = NSLineBreakByClipping;
+		[panel.contentView addSubview:text];
+	}
+
+	// Apple silicon Macs have one integrated GPU. This optional I/O Registry
+	// statistic is device-wide and can be absent on a particular OS or driver.
+	gpu = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("IOAccelerator"));
+	refresh_timer = [NSTimer timerWithTimeInterval:0.25 repeats:YES block:^(NSTimer *timer) {
+		refresh_overlay();
+	}];
+	[[NSRunLoop mainRunLoop] addTimer:refresh_timer forMode:NSRunLoopCommonModes];
+	refresh_overlay();
+	LOG("DiRT 3 performance overlay shown\n");
+}
+
+static void install_overlay_monitor(void)
+{
+	key_monitor = [[NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown | NSEventMaskKeyUp
+		handler:^NSEvent *(NSEvent *event) {
+			NSEventModifierFlags modifiers = NSEventModifierFlagCommand | NSEventModifierFlagControl |
+				NSEventModifierFlagOption | NSEventModifierFlagShift;
+			if (event.keyCode != kVK_F9 || (event.modifierFlags & modifiers)) return event;
+			if (event.type == NSEventTypeKeyDown && !event.isARepeat) toggle_overlay();
+			return nil;
+		}] retain];
+	[[NSNotificationCenter defaultCenter] addObserverForName:NSWindowDidResignKeyNotification
+		object:nil queue:nil usingBlock:^(NSNotification *notification) {
+			if (notification.object == panel.parentWindow) suspend_overlay();
+		}];
+	[[NSNotificationCenter defaultCenter] addObserverForName:NSApplicationWillTerminateNotification
+		object:NSApp queue:nil usingBlock:^(NSNotification *notification) {
+			if (key_monitor) [NSEvent removeMonitor:key_monitor];
+			[key_monitor release];
+			key_monitor = nil;
+			hide_overlay();
+		}];
+}
+
+CGLError dirt3_flush_drawable(CGLContextObj context)
+{
+	CGLError result = CGLFlushDrawable(context);
+	if (result != kCGLNoError) return result;
+	if (atomic_load_explicit(&recording, memory_order_relaxed)) {
+		record_present(context);
+	} else if (!atomic_load_explicit(&monitor_installed, memory_order_relaxed) &&
+		dirt3_version_patch_active() &&
+		!atomic_exchange_explicit(&monitor_installed, true, memory_order_relaxed)) {
+		dispatch_async(dispatch_get_main_queue(), ^{ install_overlay_monitor(); });
+	}
+	return result;
+}
diff --git a/src/dirt3_window_mode.c b/src/dirt3_window_mode.c
new file mode 100644
index 0000000..a7a60c7
--- /dev/null
+++ b/src/dirt3_window_mode.c
@@ -0,0 +1,74 @@
+// Apply the launcher's window choice to Feral's existing registry setting.
+#include "mac32.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <string.h>
+#include <unistd.h>
+
+static char fullscreen;
+
+void dirt3_window_mode_init(void)
+{
+    const char *mode = getenv("MAC32_DIRT3_WINDOW_MODE");
+    if (!mode) return;
+    if (!strcmp(mode, "windowed")) fullscreen = '0';
+    if (!strcmp(mode, "fullscreen")) fullscreen = '1';
+}
+
+bool dirt3_window_mode_keeps_cursor(void)
+{
+    return fullscreen == '0';
+}
+
+static bool is_preferences(const char *path)
+{
+    static const char suffix[] = "/Feral Interactive/DiRT 3 Complete Edition/Preferences Data";
+    size_t length = strlen(path);
+    return length >= sizeof(suffix) - 1 && !memcmp(path + length - (sizeof(suffix) - 1), suffix, sizeof(suffix));
+}
+
+void dirt3_window_mode_read(int fd, void *bytes, int32_t size)
+{
+    static const char key[] = "<value name=\"FullScreen\" type=\"integer\">";
+    static const char end[] = "</value>";
+    if (!fullscreen || size < (int32_t)(sizeof(key) + sizeof(end) - 1)) return;
+    char *value = memmem(bytes, (size_t)size, key, sizeof(key) - 1);
+    if (!value) return;
+    value += sizeof(key) - 1;
+    if ((size_t)(value - (char *)bytes) + sizeof(end) > (size_t)size ||
+        (*value != '0' && *value != '1') || memcmp(value + 1, end, sizeof(end) - 1)) return;
+    char path[PATH_MAX];
+    if (fcntl(fd, F_GETPATH, path) < 0 || !is_preferences(path)) return;
+    *value = fullscreen;
+    LOG("DiRT 3 display mode: %s\n", fullscreen == '0' ? "windowed" : "fullscreen");
+}
+
+int dirt3_window_mode_missing_preferences(const char *path, int flags)
+{
+    // The game merges these settings into its built-in defaults. A temporary
+    // stream supplies the one preference on the first windowed launch.
+    if (fullscreen != '0' || !path || flags != O_RDONLY || !is_preferences(path)) {
+        errno = ENOENT;
+        return -1;
+    }
+    FILE *preferences = tmpfile();
+    if (!preferences) return -1;
+    static const char xml[] =
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+        "<registry><key name=\"HKEY_CURRENT_USER\"><key name=\"Software\">"
+        "<key name=\"Feral Interactive\"><key name=\"DiRT 3 Complete Edition\">"
+        "<key name=\"Setup\"><value name=\"FullScreen\" type=\"integer\">0</value>"
+        "</key></key></key></key></key></registry>\n";
+    int fd = -1;
+    if (fwrite(xml, 1, sizeof(xml) - 1, preferences) == sizeof(xml) - 1 &&
+        fflush(preferences) == 0 && fseek(preferences, 0, SEEK_SET) == 0)
+        fd = fcntl(fileno(preferences), F_DUPFD_CLOEXEC, 0);
+    fclose(preferences);
+    if (fd >= 0)
+        LOG("DiRT 3 display mode: windowed on first launch\n");
+    else
+        errno = ENOENT;
+    return fd;
+}
