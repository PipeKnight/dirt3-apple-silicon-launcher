+extern int dirt3_version_patch_active(void);
+
+// DiRT 3 renders its selected size into a borderless window. The original
+// 640×480 default may no longer exist as a physical display mode, even
+// though the game can still render at that size. Include it in the guest's
+// mode list so that a saved default resolves to a selectable menu entry.
+struct dirt3_render_mode {
+	uint32_t width, height, flags;
+	double refresh;
+};
+
+static const struct dirt3_render_mode *dirt3_render_mode(CGDisplayModeRef mode)
+{
+	if (!mode || !dirt3_version_patch_active() || CFGetTypeID(mode) != CFDataGetTypeID())
+		return NULL;
+	CFDataRef data = (CFDataRef)mode;
+	return CFDataGetLength(data) == sizeof(struct dirt3_render_mode)
+		? (const struct dirt3_render_mode *)CFDataGetBytePtr(data) : NULL;
+}
+
+static uint32_t w_CGDisplayModeGetWidth(CGDisplayModeRef m)
+{
+	const struct dirt3_render_mode *mode = dirt3_render_mode(m);
+	return mode ? mode->width : (uint32_t)CGDisplayModeGetWidth(m);
+}
+
+static uint32_t w_CGDisplayModeGetHeight(CGDisplayModeRef m)
+{
+	const struct dirt3_render_mode *mode = dirt3_render_mode(m);
+	return mode ? mode->height : (uint32_t)CGDisplayModeGetHeight(m);
+}
+
+static double w_CGDisplayModeGetRefreshRate(CGDisplayModeRef m)
+{
+	const struct dirt3_render_mode *mode = dirt3_render_mode(m);
+	return mode ? mode->refresh : CGDisplayModeGetRefreshRate(m);
+}
+
+uint32_t w_CGDisplayModeGetIOFlags(CGDisplayModeRef m)
+{
+	const struct dirt3_render_mode *mode = dirt3_render_mode(m);
+	return mode ? mode->flags : CGDisplayModeGetIOFlags(m);
+}
+
+static uint32_t w_CGDisplayModeGetIODisplayModeID(CGDisplayModeRef m)
+{
+	return dirt3_render_mode(m) ? 0 : CGDisplayModeGetIODisplayModeID(m);
+}
+
+static int w_CGDisplayModeIsUsableForDesktopGUI(CGDisplayModeRef m)
+{
+	return dirt3_render_mode(m) ? 1 : CGDisplayModeIsUsableForDesktopGUI(m);
+}
+
+static void add_dirt3_render_mode(CFMutableArrayRef modes, CGDisplayModeRef desktop,
+	uint32_t width, uint32_t height)
+{
+	if (width > CGDisplayModeGetWidth(desktop) || height > CGDisplayModeGetHeight(desktop))
+		return;
+	double refresh = CGDisplayModeGetRefreshRate(desktop);
+	for (CFIndex i = 0; i < CFArrayGetCount(modes); i++) {
+		CGDisplayModeRef mode = (CGDisplayModeRef)CFArrayGetValueAtIndex(modes, i);
+		if (w_CGDisplayModeGetWidth(mode) == width && w_CGDisplayModeGetHeight(mode) == height &&
+		    w_CGDisplayModeGetRefreshRate(mode) == refresh)
+			return;
+	}
+	const struct dirt3_render_mode mode = { width, height, CGDisplayModeGetIOFlags(desktop), refresh };
+	CFDataRef value = CFDataCreate(NULL, (const UInt8 *)&mode, sizeof(mode));
+	if (value) {
+		CFArrayAppendValue(modes, value);
+		CFRelease(value);
+	}
+}
+
+static CFArrayRef w_CGDisplayCopyAllDisplayModes(CGDirectDisplayID display, CFDictionaryRef options)
+{
+	if (!dirt3_version_patch_active() || options)
+		return CGDisplayCopyAllDisplayModes(display, options);
+
+	// The game compares mode dimensions to the desktop's logical size.
+	// macOS can exclude the matching HiDPI modes from the default list.
+	const void *keys[] = { kCGDisplayShowDuplicateLowResolutionModes };
+	const void *values[] = { kCFBooleanTrue };
+	options = CFDictionaryCreate(NULL, keys, values, 1,
+		&kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+	CFArrayRef modes = CGDisplayCopyAllDisplayModes(display, options);
+	if (options) CFRelease(options);
+	if (!modes) return NULL;
+
+	CGDisplayModeRef desktop = CGDisplayCopyDisplayMode(display);
+	if (!desktop) return modes;
+	CFMutableArrayRef available = CFArrayCreateMutableCopy(NULL, 0, modes);
+	if (available) {
+		add_dirt3_render_mode(available, desktop, 640, 480);
+		add_dirt3_render_mode(available, desktop, 1280, 720);
+		CFRelease(modes);
+		modes = available;
+	}
+	CGDisplayModeRelease(desktop);
+	return modes;
+}
