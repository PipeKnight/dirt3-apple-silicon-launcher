+static void patch_terminal_flash(struct image *image, const struct profile *profile)
+{
+	g32 constants;
+	uint32_t size;
+	if (!macho_section(image, "__DATA", "__const", &constants, &size)) return;
+	g32 slide = (g32)macho_image_slide(0);
+	g32 table = profile->flash.table + slide;
+	const unsigned enter = 0x10 / sizeof(g32), exit = 0x2c / sizeof(g32), tick = 0x38 / sizeof(g32);
+	const size_t checked_bytes = (tick + 1) * sizeof(g32);
+	if (table < constants || size < checked_bytes || table - constants > size - checked_bytes) return;
+	g32 *functions = G2H(table);
+	if (functions[enter] != profile->flash.enter + slide ||
+		functions[exit] != profile->flash.exit + slide ||
+		functions[tick] != profile->flash.tick + slide) return;
+	flash_enter = functions[enter];
+	flash_exit = functions[exit];
+	flash_tick = functions[tick];
+	functions[enter] = hfn_stub(&terminal_enter_thunk);
+	functions[exit] = hfn_stub(&terminal_exit_thunk);
+	functions[tick] = hfn_stub(&terminal_tick_thunk);
+	LOG("DiRT 3 terminal slow-motion transitions available\n");
+}
