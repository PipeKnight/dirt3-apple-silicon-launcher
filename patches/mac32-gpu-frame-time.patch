+static bool supports_gpu_query(void)
+{
+	const char *version = (const char *)glGetString(GL_VERSION);
+	if (!version) return false;
+	if (version[0] < '3') {
+		const char *extensions = (const char *)glGetString(GL_EXTENSIONS);
+		if (!extensions || !strstr(extensions, "GL_EXT_timer_query")) return false;
+	} else {
+		int major = 0, minor = 0;
+		if (sscanf(version, "%d.%d", &major, &minor) != 2 || (major == 3 && minor < 3))
+			return false;
+	}
+	GLint bits = 0;
+	glGetQueryiv(GL_TIME_ELAPSED, GL_QUERY_COUNTER_BITS, &bits);
+	return bits > 0;
+}
+
+static void finish_gpu_query(CGLContextObj context, bool keep)
+{
+	if (!atomic_load_explicit(&gpu_query_active, memory_order_relaxed)) return;
+	os_unfair_lock_lock(&gpu_query_lock);
+	if (gpu_query.context == context && context == CGLGetCurrentContext() &&
+		atomic_load_explicit(&gpu_query_active, memory_order_relaxed)) {
+		glEndQuery(GL_TIME_ELAPSED);
+		atomic_store_explicit(&gpu_query_active, false, memory_order_relaxed);
+		gpu_query.pending = keep;
+		gpu_query.end = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+		gpu_query.next_poll = gpu_query.end + gpu_poll_interval;
+	}
+	os_unfair_lock_unlock(&gpu_query_lock);
+}
+
+void dirt3_cancel_gpu_query(void)
+{
+	if (atomic_load_explicit(&gpu_query_active, memory_order_relaxed))
+		finish_gpu_query(CGLGetCurrentContext(), false);
+}
+
+CGLError dirt3_destroy_cgl_context(CGLContextObj context)
+{
+	os_unfair_lock_lock(&gpu_query_lock);
+	if (gpu_query.context == context) {
+		if (context == CGLGetCurrentContext()) {
+			if (atomic_load_explicit(&gpu_query_active, memory_order_relaxed)) glEndQuery(GL_TIME_ELAPSED);
+			if (gpu_query.name) glDeleteQueries(1, &gpu_query.name);
+		}
+		// OpenGL frees any remaining query object when it destroys the context.
+		memset(&gpu_query, 0, sizeof(gpu_query));
+		atomic_store_explicit(&gpu_query_active, false, memory_order_relaxed);
+	}
+	os_unfair_lock_unlock(&gpu_query_lock);
+	return CGLDestroyContext(context);
+}
+
+static void sample_gpu_frame(CGLContextObj context, uint64_t generation, uint64_t now)
+{
+	os_unfair_lock_lock(&gpu_query_lock);
+	if (gpu_query.context != context) {
+		// An in-flight query belongs to its context even when another is
+		// temporarily current. Finish the timer on its next present.
+		if (atomic_load_explicit(&gpu_query_active, memory_order_relaxed)) goto done;
+		memset(&gpu_query, 0, sizeof(gpu_query));
+		gpu_query.context = context;
+		gpu_query.supported = supports_gpu_query();
+	}
+	if (!gpu_query.supported) goto done;
+	if (gpu_query.pending && now >= gpu_query.next_poll) {
+		GLuint ready = GL_FALSE;
+		glGetQueryObjectuiv(gpu_query.name, GL_QUERY_RESULT_AVAILABLE, &ready);
+		gpu_query.next_poll = now + gpu_poll_interval;
+		if (ready) {
+			GLuint64 elapsed = 0;
+			glGetQueryObjectui64v(gpu_query.name, GL_QUERY_RESULT, &elapsed);
+			gpu_query.pending = false;
+			os_unfair_lock_lock(&frame_lock);
+			if (frames.context == context && frames.generation == gpu_query.generation &&
+				now - gpu_query.end < no_present_ns && elapsed && elapsed < no_present_ns) {
+				frames.gpu_end = gpu_query.end;
+				frames.gpu_elapsed = elapsed;
+			}
+			os_unfair_lock_unlock(&frame_lock);
+		}
+	}
+	if (!gpu_query.pending && now - gpu_query.begin >= gpu_sample_interval &&
+		!atomic_load_explicit(&gpu_query_active, memory_order_relaxed)) {
+		gpu_query.begin = now;
+		GLint current = 0;
+		glGetQueryiv(GL_TIME_ELAPSED, GL_CURRENT_QUERY, &current);
+		if (!current) {
+			if (!gpu_query.name) glGenQueries(1, &gpu_query.name);
+			if (gpu_query.name) {
+				glBeginQuery(GL_TIME_ELAPSED, gpu_query.name);
+				gpu_query.generation = generation;
+				atomic_store_explicit(&gpu_query_active, true, memory_order_relaxed);
+			}
+		}
+	}
+done:
+	os_unfair_lock_unlock(&gpu_query_lock);
 }
 
