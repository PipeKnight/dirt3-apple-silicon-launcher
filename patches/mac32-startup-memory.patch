+	G("_malloc_zone_from_ptr", zone_from_ptr, "u:u"),
+	G("_malloc_zone_malloc", zone_malloc, "u:uu"),
+	G("_malloc_zone_calloc", zone_calloc, "u:uuu"),
+	G("_malloc_zone_valloc", zone_valloc, "u:uu"),
+	G("_malloc_zone_free", zone_free, "v:uu"),
+	G("_malloc_zone_realloc", zone_realloc, "u:uuu"),
+	G("_malloc_zone_memalign", zone_memalign, "u:uuu"),
+};
