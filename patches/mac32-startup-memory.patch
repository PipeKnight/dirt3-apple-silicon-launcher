+struct display_callback {
+	g32 function, context;
+	struct display_callback *next;
+};
+static pthread_mutex_t display_callbacks_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct display_callback *display_callbacks;
+
+static void display_changed(CGDirectDisplayID display, CGDisplayChangeSummaryFlags flags, void *context)
+{
+	const struct display_callback *callback = context;
+	gcall(callback->function, 3, display, flags, callback->context);
+}
+
+static CGError w_CGDisplayRegisterReconfigurationCallback(g32 function, g32 context)
+{
+	if (!function) return kCGErrorIllegalArgument;
+	pthread_mutex_lock(&display_callbacks_lock);
+	for (struct display_callback *it = display_callbacks; it; it = it->next) {
+		if (it->function == function && it->context == context) {
+			pthread_mutex_unlock(&display_callbacks_lock);
+			return kCGErrorSuccess;
+		}
+	}
+	struct display_callback *callback = malloc(sizeof *callback);
+	if (!callback) {
+		pthread_mutex_unlock(&display_callbacks_lock);
+		return kCGErrorFailure;
+	}
+	*callback = (struct display_callback){ function, context, display_callbacks };
+	CGError status = CGDisplayRegisterReconfigurationCallback(display_changed, callback);
+	if (!status) display_callbacks = callback;
+	else free(callback);
+	pthread_mutex_unlock(&display_callbacks_lock);
+	return status;
+}
+
+static CGError w_CGDisplayRemoveReconfigurationCallback(g32 function, g32 context)
+{
+	pthread_mutex_lock(&display_callbacks_lock);
+	struct display_callback **slot = &display_callbacks;
+	for (; *slot; slot = &(*slot)->next) {
+		struct display_callback *callback = *slot;
+		if (callback->function == function && callback->context == context) {
+			CGError status = CGDisplayRemoveReconfigurationCallback(display_changed, callback);
+			if (!status) {
+				*slot = callback->next;
+				free(callback);
+			}
+			pthread_mutex_unlock(&display_callbacks_lock);
+			return status;
+		}
+	}
+	pthread_mutex_unlock(&display_callbacks_lock);
+	return kCGErrorIllegalArgument;
+}
