diff --git a/src/legacy_crypto.c b/src/legacy_crypto.c
new file mode 100644
index 0000000..82445a9
--- /dev/null
+++ b/src/legacy_crypto.c
@@ -0,0 +1,194 @@
+// OpenSSL 0.9.8 guest objects, backed by the system libcrypto. The guest
+// can write the public modulus and exponent into its old RSA structure.
+#include "thunks.h"
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <string.h>
+#include <os/lock.h>
+
+struct bignum;
+struct rsa;
+struct rsa32 {
+	uint32_t prefix[4];
+	g32 modulus, exponent;
+};
+_Static_assert(offsetof(struct rsa32, modulus) == 16, "i386 OpenSSL 0.9.8 RSA modulus offset");
+
+static struct {
+	void *library;
+	struct bignum *(*bn_from_bytes)(const void *, int, struct bignum *);
+	struct bignum *(*bn_dup)(const struct bignum *);
+	void (*bn_free)(struct bignum *);
+	struct rsa *(*rsa_new)(void);
+	void (*rsa_free)(struct rsa *);
+	int (*rsa_set_key)(struct rsa *, struct bignum *, struct bignum *, struct bignum *);
+	int (*rsa_verify)(int, const void *, unsigned, const void *, unsigned, struct rsa *);
+	unsigned char *(*digest)(const void *, size_t, unsigned char *);
+	int (*digest_init)(void *);
+	int (*digest_update)(void *, const void *, size_t);
+	int (*digest_final)(unsigned char *, void *);
+	int ready;
+} crypto;
+
+static pthread_once_t load_once = PTHREAD_ONCE_INIT;
+static os_unfair_lock allocator_lock = OS_UNFAIR_LOCK_INIT;
+static g32 alloc_callback, free_callback;
+static bool allocation_started;
+
+static void load_crypto(void)
+{
+	crypto.library = dlopen("/usr/lib/libcrypto.46.dylib", RTLD_LAZY | RTLD_LOCAL | RTLD_FIRST);
+	if (!crypto.library)
+		crypto.library = dlopen("/usr/lib/libcrypto.44.dylib", RTLD_LAZY | RTLD_LOCAL | RTLD_FIRST);
+	if (!crypto.library) return;
+#define LOAD(member, symbol) do { \
+	crypto.member = dlsym(crypto.library, symbol); \
+	if (!crypto.member) return; \
+} while (0)
+	LOAD(bn_from_bytes, "BN_bin2bn");
+	LOAD(bn_dup, "BN_dup");
+	LOAD(bn_free, "BN_free");
+	LOAD(rsa_new, "RSA_new");
+	LOAD(rsa_free, "RSA_free");
+	LOAD(rsa_set_key, "RSA_set0_key");
+	LOAD(rsa_verify, "RSA_verify");
+	LOAD(digest, "RIPEMD160");
+	LOAD(digest_init, "RIPEMD160_Init");
+	LOAD(digest_update, "RIPEMD160_Update");
+	LOAD(digest_final, "RIPEMD160_Final");
+#undef LOAD
+	crypto.ready = 1;
+}
+
+static bool available(void)
+{
+	pthread_once(&load_once, load_crypto);
+	return crypto.ready;
+}
+
+static int set_guest_memory_functions(g32 allocate, g32 reallocate, g32 release)
+{
+	if (!allocate || !reallocate || !release || !available()) return 0;
+	os_unfair_lock_lock(&allocator_lock);
+	bool changed = !allocation_started;
+	if (changed) {
+		alloc_callback = allocate;
+		free_callback = release;
+	}
+	os_unfair_lock_unlock(&allocator_lock);
+	return changed;
+}
+
+static g32 crypto_alloc(uint32_t n)
+{
+	os_unfair_lock_lock(&allocator_lock);
+	allocation_started = true;
+	g32 function = alloc_callback;
+	os_unfair_lock_unlock(&allocator_lock);
+	g32 address = function ? (g32)gcall(function, 1, n) : gmalloc(n);
+	if (address) memset(G2H(address), 0, n);
+	return address;
+}
+
+static void crypto_free(g32 address)
+{
+	if (!address) return;
+	if (free_callback) gcall(free_callback, 1, address);
+	else gfree(address);
+}
+
+static struct bignum *native_bn(g32 guest)
+{
+	struct bignum *number = NULL;
+	if (guest) memcpy(&number, G2H(guest), sizeof number);
+	return number;
+}
+
+static g32 w_BN_bin2bn(const void *bytes, int32_t count, g32 existing)
+{
+	if (count < 0 || !available()) return 0;
+	g32 guest = existing ? existing : crypto_alloc(sizeof(struct bignum *));
+	if (!guest) return 0;
+	struct bignum *number = crypto.bn_from_bytes(bytes, count, native_bn(guest));
+	if (!number) {
+		if (!existing) crypto_free(guest);
+		return 0;
+	}
+	memcpy(G2H(guest), &number, sizeof number);
+	return guest;
+}
+
+static g32 w_RSA_new(void)
+{
+	return available() ? crypto_alloc(sizeof(struct rsa32)) : 0;
+}
+
+static void free_bn(g32 guest)
+{
+	if (!guest) return;
+	crypto.bn_free(native_bn(guest));
+	crypto_free(guest);
+}
+
+static void w_RSA_free(g32 address)
+{
+	if (!address) return;
+	const struct rsa32 *guest = G2H(address);
+	free_bn(guest->modulus);
+	if (guest->exponent != guest->modulus) free_bn(guest->exponent);
+	crypto_free(address);
+}
+
+static int w_RSA_verify(int32_t type, const void *digest, uint32_t digest_length,
+	const void *signature, uint32_t signature_length, const struct rsa32 *guest)
+{
+	if (!available() || !guest || !guest->modulus || !guest->exponent) return 0;
+	struct bignum *n = crypto.bn_dup(native_bn(guest->modulus));
+	struct bignum *e = crypto.bn_dup(native_bn(guest->exponent));
+	struct rsa *key = crypto.rsa_new();
+	int valid = 0;
+	if (key && n && e && crypto.rsa_set_key(key, n, e, NULL))
+		valid = crypto.rsa_verify(type, digest, digest_length, signature, signature_length, key);
+	else {
+		crypto.bn_free(n);
+		crypto.bn_free(e);
+	}
+	crypto.rsa_free(key);
+	return valid;
+}
+
+// RIPEMD160_CTX uses 24 uint32_t fields in both libcrypto versions.
+static g32 w_RIPEMD160(const void *data, uint32_t size, unsigned char *output)
+{
+	if (!available()) return 0;
+	static __thread g32 scratch;
+	if (!output) {
+		if (!scratch) scratch = gmalloc(20);
+		output = G2H(scratch);
+	}
+	return H2G(crypto.digest(data, size, output));
+}
+
+static int w_RIPEMD160_Init(void *ctx) { return available() && crypto.digest_init(ctx); }
+static int w_RIPEMD160_Update(void *ctx, const void *data, uint32_t size)
+{
+	return available() && crypto.digest_update(ctx, data, size);
+}
+static int w_RIPEMD160_Final(unsigned char *digest, void *ctx)
+{
+	return available() && crypto.digest_final(digest, ctx);
+}
+
+static struct hfn crypto_entries[] = {
+	G("_CRYPTO_set_mem_functions", set_guest_memory_functions, "i:uuu"),
+	G("_BN_bin2bn", w_BN_bin2bn, "u:piu"),
+	G("_RSA_new", w_RSA_new, "u:"), G("_RSA_free", w_RSA_free, "v:u"),
+	G("_RSA_verify", w_RSA_verify, "i:ipupup"),
+	G("_RIPEMD160", w_RIPEMD160, "u:pup"),
+	G("_RIPEMD160_Init", w_RIPEMD160_Init, "i:p"),
+	G("_RIPEMD160_Update", w_RIPEMD160_Update, "i:ppu"),
+	G("_RIPEMD160_Final", w_RIPEMD160_Final, "i:pp"),
+};
+
+void thunks_legacy_crypto_init(void) { REGISTER(crypto_entries); }
