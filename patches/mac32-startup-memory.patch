+static void forget_kernel_handle(g32 guest)
+{
+	os_unfair_lock_lock(&handles_lock);
+	for (struct kernel_handle **slot = &kernel_handles; *slot; slot = &(*slot)->next) {
+		struct kernel_handle *entry = *slot;
+		if (entry->guest == guest) {
+			*slot = entry->next;
+			free(entry);
+			break;
+		}
+	}
+	os_unfair_lock_unlock(&handles_lock);
