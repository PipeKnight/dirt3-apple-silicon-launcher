+static void t_HIObjectRegisterSubclass(uint32_t *args, struct hres *r)
+{
+	static ffi_type *types[] = { &ffi_type_pointer, &ffi_type_pointer, &ffi_type_pointer };
+	struct hi_constructor *bridge = NULL;
+	void *entry = NULL;
+	if (A(3)) {
+		bridge = calloc(1, sizeof *bridge);
+		if (!bridge) { RET(memFullErr); return; }
+		bridge->guest_handler = A(3);
+		bridge->closure = ffi_closure_alloc(sizeof(ffi_closure), &entry);
+		if (!bridge->closure ||
+		    ffi_prep_cif(&bridge->signature, FFI_DEFAULT_ABI, 3, &ffi_type_sint32, types) != FFI_OK ||
+		    ffi_prep_closure_loc(bridge->closure, &bridge->signature, call_hi_constructor, bridge, entry) != FFI_OK) {
+			if (bridge->closure) ffi_closure_free(bridge->closure);
+			free(bridge);
+			RET(memFullErr);
+			return;
+		}
+	}
+	HIObjectClassRef class_ref = NULL;
+	OSStatus status = HIObjectRegisterSubclass(hobj_unwrap(A(0)), hobj_unwrap(A(1)),
+		A(2), (EventHandlerUPP)entry, A(4), G2H(A(5)), G2H(A(6)), &class_ref);
+	if (status == noErr) {
+		if (A(7)) U32(A(7)) = hobj_wrap(class_ref);
+		// Carbon stores the closure for the lifetime of the registered class.
+	} else if (bridge) {
+		ffi_closure_free(bridge->closure);
+		free(bridge);
+	}
+	RET(status);
+}
