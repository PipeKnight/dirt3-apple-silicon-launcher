index 0000000..e724caa
--- /dev/null
+++ b/src/cf_streams.c
@@ -0,0 +1,198 @@
+// CoreFoundation streams and CFNetwork HTTP messages. Stream contexts
+// contain i386 callbacks and are owned for as long as CF keeps the client.
+#include "thunks.h"
+#include <CFNetwork/CFNetwork.h>
+#include <stdatomic.h>
+#include <string.h>
+
+struct stream_client32 { uint32_t version; g32 info, retain, release, description; };
+struct stream_client {
+	struct stream_client32 guest;
+	g32 callback;
+	atomic_uint references;
+};
+
+static void *retain_client(void *context)
+{
+	struct stream_client *client = (void *)context;
+	if (client->guest.retain)
+		client->guest.info = (g32)gcall(client->guest.retain, 1, client->guest.info);
+	atomic_fetch_add_explicit(&client->references, 1, memory_order_relaxed);
+	return client;
+}
+
+static void drop_client(struct stream_client *client)
+{
+	if (atomic_fetch_sub_explicit(&client->references, 1, memory_order_acq_rel) == 1)
+		free(client);
+}
+
+static void release_client(void *context)
+{
+	struct stream_client *client = (void *)context;
+	if (client->guest.release) gcall(client->guest.release, 1, client->guest.info);
+	drop_client(client);
+}
+
+static CFStringRef describe_client(void *context)
+{
+	const struct stream_client *client = context;
+	return hobj_unwrap((g32)gcall(client->guest.description, 1, client->guest.info));
+}
+
+static void notify(void *stream, CFStreamEventType type, const struct stream_client *client)
+{
+	gcall(client->callback, 3, hobj_wrap(stream), (uint32_t)type, client->guest.info);
+}
+
+static void notify_reader(CFReadStreamRef stream, CFStreamEventType type, void *context)
+{
+	notify(stream, type, context);
+}
+
+static void notify_writer(CFWriteStreamRef stream, CFStreamEventType type, void *context)
+{
+	notify(stream, type, context);
+}
+
+static struct stream_client *make_client(g32 callback, const struct stream_client32 *guest)
+{
+	if (guest && guest->version != 0) return NULL;
+	struct stream_client *client = calloc(1, sizeof *client);
+	if (!client) return NULL;
+	if (guest) client->guest = *guest;
+	client->callback = callback;
+	atomic_init(&client->references, 1);
+	return client;
+}
+
+static Boolean set_client(g32 stream, uint32_t flags, g32 callback, const struct stream_client32 *guest, int write)
+{
+	void *native = hobj_unwrap(stream);
+	if (!callback || !flags)
+		return write ? CFWriteStreamSetClient(native, flags, NULL, NULL)
+			: CFReadStreamSetClient(native, flags, NULL, NULL);
+	struct stream_client *client = make_client(callback, guest);
+	if (!client) return false;
+	CFStreamClientContext ctx = {
+		.version = 0, .info = client, .retain = retain_client, .release = release_client,
+		.copyDescription = client->guest.description ? describe_client : NULL,
+	};
+	Boolean ok = write ? CFWriteStreamSetClient(native, flags, notify_writer, &ctx)
+		: CFReadStreamSetClient(native, flags, notify_reader, &ctx);
+	drop_client(client);
+	return ok;
+}
+
+static void t_CFReadStreamSetClient(uint32_t *args, struct hres *r)
+{
+	RET(set_client(A(0), A(1), A(2), G2H(A(3)), 0));
+}
+
+static void t_CFWriteStreamSetClient(uint32_t *args, struct hres *r)
+{
+	RET(set_client(A(0), A(1), A(2), G2H(A(3)), 1));
+}
+
+static void t_CFStreamCreatePairWithSocketToHost(uint32_t *args, struct hres *r)
+{
+	CFReadStreamRef read = NULL;
+	CFWriteStreamRef write = NULL;
+	CFStreamCreatePairWithSocketToHost(hobj_unwrap(A(0)), hobj_unwrap(A(1)), A(2),
+		A(3) ? &read : NULL, A(4) ? &write : NULL);
+	if (A(3)) *(g32 *)G2H(A(3)) = hobj_wrap(read);
+	if (A(4)) *(g32 *)G2H(A(4)) = hobj_wrap(write);
+}
+
+static void t_CFStreamCreatePairWithSocketToNetService(uint32_t *args, struct hres *r)
+{
+	CFReadStreamRef read = NULL;
+	CFWriteStreamRef write = NULL;
+	CFStreamCreatePairWithSocketToNetService(hobj_unwrap(A(0)), hobj_unwrap(A(1)),
+		A(2) ? &read : NULL, A(3) ? &write : NULL);
+	if (A(2)) *(g32 *)G2H(A(2)) = hobj_wrap(read);
+	if (A(3)) *(g32 *)G2H(A(3)) = hobj_wrap(write);
+}
+
+static const void *retain_timer(const void *info) { return retain_client((void *)info); }
+static void release_timer(const void *info) { release_client((void *)info); }
+static CFStringRef describe_timer(const void *info) { return describe_client((void *)info); }
+
+static void notify_timer(CFRunLoopTimerRef timer, void *context)
+{
+	const struct stream_client *client = context;
+	gcall(client->callback, 2, hobj_wrap(timer), client->guest.info);
+}
+
+static void t_CFRunLoopTimerCreate(uint32_t *args, struct hres *r)
+{
+	struct stream_client *client = A(7) ? make_client(A(7), G2H(A(8))) : NULL;
+	if (!client) { RET(0); return; }
+	CFAbsoluteTime fire_date;
+	CFTimeInterval interval;
+	memcpy(&fire_date, args + 1, sizeof fire_date);
+	memcpy(&interval, args + 3, sizeof interval);
+	CFRunLoopTimerContext context = {
+		.version = 0, .info = client, .retain = retain_timer, .release = release_timer,
+		.copyDescription = client->guest.description ? describe_timer : NULL,
+	};
+	CFRunLoopTimerRef timer = CFRunLoopTimerCreate(hobj_unwrap(A(0)), fire_date, interval,
+		A(5), (int32_t)A(6), notify_timer, &context);
+	drop_client(client);
+	RET(hobj_wrap(timer));
+}
+
+static void t_CFRunLoopTimerGetContext(uint32_t *args, struct hres *r)
+{
+	struct stream_client32 *out = G2H(A(1));
+	if (!out || out->version) return;
+	CFRunLoopTimerContext context = { .version = 0 };
+	CFRunLoopTimerGetContext(hobj_unwrap(A(0)), &context);
+	if (context.retain == retain_timer && context.info) {
+		struct stream_client *client = context.info;
+		*out = client->guest;
+	} else {
+		*out = (struct stream_client32){0};
+	}
+}
+
+static struct hfn stream_entries[] = {
+	R("_CFRunLoopTimerCreate", t_CFRunLoopTimerCreate),
+	R("_CFRunLoopTimerGetContext", t_CFRunLoopTimerGetContext),
+	G("_CFRunLoopAddTimer", CFRunLoopAddTimer, "v:ooo"),
+	G("_CFRunLoopRemoveTimer", CFRunLoopRemoveTimer, "v:ooo"),
+	G("_CFRunLoopGetNextTimerFireDate", CFRunLoopGetNextTimerFireDate, "d:oo"),
+	G("_CFHTTPMessageCreateRequest", CFHTTPMessageCreateRequest, "o:oooo"),
+	G("_CFHTTPMessageAppendBytes", CFHTTPMessageAppendBytes, "b:opi"),
+	G("_CFHTTPMessageCopyAllHeaderFields", CFHTTPMessageCopyAllHeaderFields, "o:o"),
+	G("_CFHTTPMessageCopyBody", CFHTTPMessageCopyBody, "o:o"),
+	G("_CFHTTPMessageGetResponseStatusCode", CFHTTPMessageGetResponseStatusCode, "i:o"),
+	G("_CFHTTPMessageSetBody", CFHTTPMessageSetBody, "v:oo"),
+	G("_CFHTTPMessageSetHeaderFieldValue", CFHTTPMessageSetHeaderFieldValue, "v:ooo"),
+	G("_CFReadStreamCreateForHTTPRequest", CFReadStreamCreateForHTTPRequest, "o:oo"),
+	G("_CFReadStreamCreateWithFile", CFReadStreamCreateWithFile, "o:oo"),
+	G("_CFReadStreamOpen", CFReadStreamOpen, "b:o"),
+	G("_CFReadStreamRead", CFReadStreamRead, "i:opi"),
+	G("_CFReadStreamClose", CFReadStreamClose, "v:o"),
+	G("_CFReadStreamCopyProperty", CFReadStreamCopyProperty, "o:oo"),
+	G("_CFReadStreamHasBytesAvailable", CFReadStreamHasBytesAvailable, "b:o"),
+	G("_CFReadStreamScheduleWithRunLoop", CFReadStreamScheduleWithRunLoop, "v:ooo"),
+	G("_CFReadStreamUnscheduleFromRunLoop", CFReadStreamUnscheduleFromRunLoop, "v:ooo"),
+	G("_CFReadStreamSetProperty", CFReadStreamSetProperty, "b:ooo"),
+	R("_CFReadStreamSetClient", t_CFReadStreamSetClient),
+	G("_CFWriteStreamCanAcceptBytes", CFWriteStreamCanAcceptBytes, "b:o"),
+	G("_CFWriteStreamClose", CFWriteStreamClose, "v:o"),
+	G("_CFWriteStreamCopyError", CFWriteStreamCopyError, "o:o"),
+	G("_CFWriteStreamCreateWithFile", CFWriteStreamCreateWithFile, "o:oo"),
+	G("_CFWriteStreamGetStatus", CFWriteStreamGetStatus, "i:o"),
+	G("_CFWriteStreamOpen", CFWriteStreamOpen, "b:o"),
+	G("_CFWriteStreamScheduleWithRunLoop", CFWriteStreamScheduleWithRunLoop, "v:ooo"),
+	G("_CFWriteStreamUnscheduleFromRunLoop", CFWriteStreamUnscheduleFromRunLoop, "v:ooo"),
+	G("_CFWriteStreamSetProperty", CFWriteStreamSetProperty, "b:ooo"),
+	G("_CFWriteStreamWrite", CFWriteStreamWrite, "i:opi"),
+	R("_CFWriteStreamSetClient", t_CFWriteStreamSetClient),
+	R("_CFStreamCreatePairWithSocketToHost", t_CFStreamCreatePairWithSocketToHost),
