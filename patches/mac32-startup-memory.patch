diff --git a/patches/dirt3_2015_version.c b/patches/dirt3_2015_version.c
new file mode 100644
index 0000000..83dcc88
--- /dev/null
+++ b/patches/dirt3_2015_version.c
@@ -0,0 +1,80 @@
+#include "../src/patches.h"
+#include <CoreServices/CoreServices.h>
+#include <string.h>
+
+static int version_patch_active;
+static _Thread_local int serializing_web_display;
+static g32 parse_json, empty_array;
+
+int dirt3_set_serializing_web_display(int active)
+{
+	int previous = serializing_web_display;
+	serializing_web_display = active;
+	return previous;
+}
+
+static void parse_launcher_json(uint32_t *args, struct hres *r)
+{
+	g32 input = A(0);
+	if (serializing_web_display && (!input || !*(const char *)G2H(input)))
+		input = empty_array;
+	RET(gcall(parse_json, 1, input));
+}
+
+static struct hfn parse_json_thunk = R("DiRT 3 launcher JSON", parse_launcher_json);
+int dirt3_version_patch_active(void) { return version_patch_active; }
+extern int macho_section(struct image *, const char *, const char *, g32 *, uint32_t *);
+
+// The game converts Gestalt's three components to the old 0x10xy format.
+// Its calculation clears the major field for releases 11 through 15, so
+// its launcher rejects a newer system as older than its 10.x minimum.
+static int apply(struct image *image)
+{
+	SInt32 major = 0;
+	if (Gestalt(gestaltSystemVersionMajor, &major) != noErr || major <= 10)
+		return 0;
+
+	static const uint8_t packing[] = {
+		0x89, 0xd9, 0x83, 0xe1, 0x10, 0xc1, 0xe1, 0x08,
+		0xba, 0x00, 0x10, 0x00, 0x00, 0x83, 0xfb, 0x0a,
+		0x0f, 0x45, 0xd1, 0x09, 0xd6, 0x09, 0xc6,
+	};
+	static const uint8_t parse_call[] = {0xe8, 0x0c, 0xe4, 0xfe, 0xff};
+	enum {
+		packing_offset = 0x781938 - 0xb980,
+		parse_call_offset = 0x8411cf - 0xb980,
+		parse_offset = 0x82f5e0 - 0xb980,
+	};
+	g32 text;
+	uint32_t text_size;
+	if (!macho_section(image, "__TEXT", "__text", &text, &text_size) ||
+		text_size < parse_call_offset + sizeof(parse_call))
+		return 0;
+	uint8_t *code = G2H(text + packing_offset);
+	uint8_t *call = G2H(text + parse_call_offset);
+	if (memcmp(code, packing, sizeof(packing)) || memcmp(call, parse_call, sizeof(parse_call)))
+		return 0;
+
+	// Saturate the legacy result at 10.15.0 and jump to its original cache
+	// store. Other version callers continue to see the real host version.
+	static const uint8_t clamp[] = {0xbe, 0xf0, 0x10, 0x00, 0x00, 0xeb, sizeof(packing) - 7};
+	memcpy(code, clamp, sizeof(clamp));
+
+	// Absent display text can reach the launcher's parser as an empty byte
+	// string. Represent missing text as an
+	// empty JSON array, the existing interface's missing-value convention.
+	parse_json = text + parse_offset;
+	empty_array = gstrdup("[]");
+	int32_t relative = (int32_t)(hfn_stub(&parse_json_thunk) - (text + parse_call_offset + sizeof(parse_call)));
+	memcpy(call + 1, &relative, sizeof(relative));
+	version_patch_active = 1;
+	return 1;
+}
+
+const struct guest_patch patch_dirt3_2015_version = {
+	.library = "DiRT 3 Complete Edition",
+	.sha256 = "0415a9ecbaccdc25752a327c7b8a0dbd62435a308d0a95652d4a286e6a579014",
+	.game = "DiRT 3 Complete Edition 1.0 (85186.17625.4091)",
+	.what = "encode newer macOS releases and preserve missing launcher text",
+	.apply = apply,
+};
diff --git a/src/aio_bridge.c b/src/aio_bridge.c
new file mode 100644
index 0000000..c3047da
--- /dev/null
+++ b/src/aio_bridge.c
@@ -0,0 +1,152 @@
+#include "thunks.h"
+
+#include <aio.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stddef.h>
+
+struct __attribute__((packed, aligned(4))) guest_aiocb {
+	int32_t fd;
+	int64_t offset;
+	g32 buffer;
+	uint32_t size;
+	int32_t priority;
+	int32_t notify, signal;
+	uint32_t value;
+	g32 notify_function, notify_attributes;
+	int32_t opcode;
+};
+_Static_assert(sizeof(struct guest_aiocb) == 48, "i386 aiocb size");
+_Static_assert(offsetof(struct guest_aiocb, notify) == 24, "i386 aio_sigevent offset");
+
+struct aio_request {
+	struct aio_request *next;
+	g32 guest;
+	unsigned references;
+	struct aiocb host;
+};
+
+static pthread_mutex_t aio_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct aio_request *requests;
+
+static struct aio_request **request_slot(g32 guest)
+{
+	struct aio_request **slot = &requests;
+	while (*slot && (*slot)->guest != guest) slot = &(*slot)->next;
+	return slot;
+}
+
+static void release_request(struct aio_request *request)
+{
+	if (request && !--request->references) free(request);
+}
+
+static int aio_fail(int error)
+{
+	errno = error;
+	return -1;
+}
+
+static int submit(g32 guest, int (*operation)(struct aiocb *))
+{
+	const struct guest_aiocb *control = G2H(guest);
+	if (!control || control->size > INT32_MAX) return aio_fail(EINVAL);
+	if (control->notify != SIGEV_NONE) return aio_fail(ENOTSUP);
+
+	struct aio_request *request = calloc(1, sizeof *request);
+	if (!request) return aio_fail(EAGAIN);
+	request->guest = guest;
+	request->references = 1;
+	request->host.aio_fildes = control->fd;
+	request->host.aio_offset = control->offset;
+	request->host.aio_buf = G2H(control->buffer);
+	request->host.aio_nbytes = control->size;
+	request->host.aio_reqprio = control->priority;
+	request->host.aio_sigevent.sigev_notify = SIGEV_NONE;
+	request->host.aio_lio_opcode = control->opcode;
+
+	pthread_mutex_lock(&aio_lock);
+	int status = *request_slot(guest) ? aio_fail(EINVAL) : operation(&request->host);
+	if (!status) {
+		request->next = requests;
+		requests = request;
+	}
+	pthread_mutex_unlock(&aio_lock);
+	if (status) {
+		int error = errno;
+		free(request);
+		return aio_fail(error);
+	}
+	return 0;
+}
+
+static int guest_aio_read(g32 guest) { return submit(guest, aio_read); }
+static int guest_aio_write(g32 guest) { return submit(guest, aio_write); }
+
+static int guest_aio_error(g32 guest)
+{
+	pthread_mutex_lock(&aio_lock);
+	struct aio_request *request = *request_slot(guest);
+	int status = request ? aio_error(&request->host) : aio_fail(EINVAL);
+	pthread_mutex_unlock(&aio_lock);
+	return status;
+}
+
+static int32_t guest_aio_return(g32 guest)
+{
+	pthread_mutex_lock(&aio_lock);
+	struct aio_request **slot = request_slot(guest);
+	struct aio_request *request = *slot;
+	int32_t result = -1;
+	if (!request) errno = EINVAL;
+	else if (aio_error(&request->host) == EINPROGRESS) errno = EINPROGRESS;
+	else {
+		result = (int32_t)aio_return(&request->host);
+		int error = errno;
+		*slot = request->next;
+		release_request(request);
+		errno = error;
+	}
+	pthread_mutex_unlock(&aio_lock);
+	return result;
+}
+
+static int guest_aio_suspend(const g32 *list, int32_t count, const int32_t *timeout32)
+{
+	if (!list || count < 1) return aio_fail(EINVAL);
+	struct timespec timeout;
+	if (timeout32) timeout = (struct timespec){timeout32[0], timeout32[1]};
+	const struct aiocb **controls = calloc((size_t)count, sizeof *controls);
+	struct aio_request **pending = calloc((size_t)count, sizeof *pending);
+	int result = -1, error = ENOMEM;
+	if (controls && pending) {
+		int valid = 1;
+		pthread_mutex_lock(&aio_lock);
+		for (int32_t i = 0; i < count; ++i) {
+			if (!list[i]) continue;
+			struct aio_request *request = *request_slot(list[i]);
+			if (!request) { valid = 0; break; }
+			++request->references;
+			pending[i] = request;
+			controls[i] = &request->host;
+		}
+		pthread_mutex_unlock(&aio_lock);
+		result = valid ? aio_suspend(controls, count, timeout32 ? &timeout : NULL) : aio_fail(EINVAL);
+		error = errno;
+		pthread_mutex_lock(&aio_lock);
+		for (int32_t i = 0; i < count; ++i) release_request(pending[i]);
+		pthread_mutex_unlock(&aio_lock);
+	}
+	free(pending);
+	free(controls);
+	if (result < 0) errno = error;
+	return result;
+}
+
+static struct hfn aio_functions[] = {
+	G("_aio_read", guest_aio_read, "i:u"), G("_aio_write", guest_aio_write, "i:u"),
+	G("_aio_error", guest_aio_error, "i:u"), G("_aio_return", guest_aio_return, "i:u"),
+	G("_aio_suspend", guest_aio_suspend, "i:pip"),
+};
+
+void thunks_aio_init(void) { REGISTER(aio_functions); }
