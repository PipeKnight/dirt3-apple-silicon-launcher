+	struct kernel_handle *entry = malloc(sizeof *entry);
+	if (!entry) die("OpenCL: cannot record a kernel argument handle");
+	os_unfair_lock_lock(&handles_lock);
+	*entry = (struct kernel_handle){ guest, native, kernel_handles };
+	kernel_handles = entry;
+	os_unfair_lock_unlock(&handles_lock);
+	return guest;
