+void thunks_malloc_zones_init(void)
+{
+	builtin = gcalloc(1, sizeof(struct zone32));
+	*zone_header(builtin) = (struct zone32){
+		.size = hfn_stub(&builtin_callbacks[0]),
+		.malloc = hfn_stub(&builtin_callbacks[1]),
+		.calloc = hfn_stub(&builtin_callbacks[2]),
+		.valloc = hfn_stub(&builtin_callbacks[3]),
