+++ b/src/malloc_zones.c
@@ -0,0 +1,257 @@
+// Guest malloc zones. Zone headers and function pointers use the i386 ABI.
+// mac32's own allocations always use its low heap directly.
+#include "thunks.h"
+#include <errno.h>
+#include <os/lock.h>
+#include <string.h>
+
+struct zone32 {
+	g32 reserved[2];
+	g32 size, malloc, calloc, valloc, free, realloc, destroy;
+	g32 name, batch_malloc, batch_free, introspect;
+	uint32_t version;
+	g32 memalign, free_definite_size;
+};
+_Static_assert(offsetof(struct zone32, version) == 52, "i386 malloc_zone_t version offset");
+
+static os_unfair_lock registry_lock = OS_UNFAIR_LOCK_INIT;
+static g32 builtin;
+static g32 initial_zones[4];
+static g32 *zones = initial_zones;
+static size_t zone_count, zone_capacity = sizeof initial_zones / sizeof initial_zones[0];
+
+// Calls made by a custom allocator to obtain its own backing storage use
+// the low heap. The host must never give a guest callback to libmalloc.
+static __thread unsigned inside_zone;
+
+static struct zone32 *zone_header(g32 zone)
+{
+	return G2H(zone);
+}
+
+static uint32_t invoke_zone(g32 callback, g32 zone, uint32_t a, uint32_t b)
+{
+	if (!callback) die("malloc: missing callback in guest zone %#x", zone);
+	inside_zone++;
+	uint32_t result = (uint32_t)gcall(callback, 3, zone, a, b);
+	inside_zone--;
+	return result;
+}
+
+static void register_zone(g32 zone)
+{
+	if (!zone) return;
+	os_unfair_lock_lock(&registry_lock);
+	for (size_t i = 0; i < zone_count; i++) {
+		if (zones[i] == zone) {
+			os_unfair_lock_unlock(&registry_lock);
+			return;
+		}
+	}
+	if (zone_count == zone_capacity) {
+		zone_capacity *= 2;
+		g32 *larger = malloc(zone_capacity * sizeof *larger);
+		if (!larger) die("malloc: cannot grow the guest zone registry");
+		memcpy(larger, zones, zone_count * sizeof *zones);
+		if (zones != initial_zones) free(zones);
+		zones = larger;
+	}
+	zones[zone_count++] = zone;
+	os_unfair_lock_unlock(&registry_lock);
+	LOG("malloc: registered guest zone %#x\n", zone);
+}
+
+static void unregister_zone(g32 zone)
+{
+	os_unfair_lock_lock(&registry_lock);
+	for (size_t i = 0; i < zone_count; i++) {
+		if (zones[i] == zone) {
+			zones[i] = zones[--zone_count];
+			break;
+		}
+	}
+	os_unfair_lock_unlock(&registry_lock);
+	LOG("malloc: unregistered guest zone %#x\n", zone);
+}
+
+static g32 default_zone(void)
+{
+	if (inside_zone) return builtin;
+	os_unfair_lock_lock(&registry_lock);
+	g32 zone = zone_count ? zones[0] : builtin;
+	os_unfair_lock_unlock(&registry_lock);
+	return zone;
+}
+
+static g32 allocation_zone(g32 ptr, uint32_t *size)
+{
+	*size = 0;
+	if (!ptr) return 0;
+
+	// Snapshot registrations and release the lock before entering any
+	// guest code. The caller of unregister owns the zone's lifetime.
+	g32 local[4];
+	g32 *snapshot = local;
+	size_t count = 0;
+	if (!inside_zone) {
+		os_unfair_lock_lock(&registry_lock);
+		count = zone_count;
+		if (count > sizeof local / sizeof local[0]) {
+			snapshot = malloc(count * sizeof *snapshot);
+			if (!snapshot) die("malloc: cannot copy the guest zone registry");
+		}
+		memcpy(snapshot, zones, count * sizeof *snapshot);
+		os_unfair_lock_unlock(&registry_lock);
+	}
+	g32 owner = 0;
+	for (size_t i = 0; i < count; i++) {
+		g32 zone = snapshot[i];
+		uint32_t n = zone == builtin ? gmalloc_query_size(ptr)
+			: invoke_zone(zone_header(zone)->size, zone, ptr, 0);
+		if (n) {
+			owner = zone;
+			*size = n;
+			break;
+		}
+	}
+	if (snapshot != local) free(snapshot);
+	if (!owner && (*size = gmalloc_query_size(ptr))) owner = builtin;
+	return owner;
