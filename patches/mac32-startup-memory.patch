+
+static OSStatus audio_file_transfer(struct guest_audio_file *file, g32 callback, SInt64 position,
+	UInt32 count, void *buffer, UInt32 *actual, bool write)
+{
+	if (!count) {
+		*actual = 0;
+		return noErr;
+	}
+	if (count > UINT32_MAX - 16) return kAudioFileUnspecifiedError;
+	g32 scratch = gmalloc(count + 4);
+	if (!scratch) return kAudioFileUnspecifiedError;
+	g32 data = scratch + 4;
+	W(scratch, 0) = 0;
+	if (write) memcpy(G2H(data), buffer, count);
+	uint64_t offset = (uint64_t)position;
+	OSStatus status = (OSStatus)gcall(callback, 6, file->context, (uint32_t)offset,
+		(uint32_t)(offset >> 32), count, data, scratch);
+	UInt32 transferred = W(scratch, 0);
+	if (transferred <= count) {
+		*actual = transferred;
+		if (!write) memcpy(buffer, G2H(data), transferred);
+	} else {
+		*actual = 0;
+		status = kAudioFileUnspecifiedError;
+	}
+	gfree(scratch);
+	return status;
+}
+
+static OSStatus audio_file_read(void *context, SInt64 position, UInt32 count, void *buffer, UInt32 *actual)
+{
+	struct guest_audio_file *file = context;
+	return audio_file_transfer(file, file->read, position, count, buffer, actual, false);
+}
+
+static OSStatus audio_file_write(void *context, SInt64 position, UInt32 count, const void *buffer, UInt32 *actual)
+{
+	struct guest_audio_file *file = context;
+	return audio_file_transfer(file, file->write, position, count, (void *)buffer, actual, true);
+}
+
+static SInt64 audio_file_get_size(void *context)
+{
+	struct guest_audio_file *file = context;
+	return (SInt64)gcall(file->get_size, 1, file->context);
+}
+
+static OSStatus audio_file_set_size(void *context, SInt64 size)
+{
+	struct guest_audio_file *file = context;
+	return (OSStatus)gcall(file->set_size, 3, file->context, (uint32_t)size, (uint32_t)((uint64_t)size >> 32));
+}
+
+static void t_AudioFileOpenWithCallbacks(uint32_t *args, struct hres *r)
+{
+	if (!A(1) || !A(3) || !A(6)) { RET(kAudioFileUnspecifiedError); return; }
+	struct guest_audio_file *file = calloc(1, sizeof *file);
+	if (!file) { RET(kAudioFileUnspecifiedError); return; }
+	file->context = A(0);
+	file->read = A(1);
+	file->write = A(2);
+	file->get_size = A(3);
+	file->set_size = A(4);
+	OSStatus status = AudioFileOpenWithCallbacks(file, audio_file_read,
+		file->write ? audio_file_write : NULL, audio_file_get_size,
+		file->set_size ? audio_file_set_size : NULL, A(5), &file->file);
+	if (status) free(file);
+	else W(A(6), 0) = hobj_wrap(file);
+	RET(status);
+}
+
+static OSStatus w_AudioFileClose(struct guest_audio_file *file)
+{
+	if (!file) return kAudioFileNotOpenError;
+	OSStatus status = AudioFileClose(file->file);
+	free(file);
+	return status;
+}
+
+static void t_ExtAudioFileWrapAudioFileID(uint32_t *args, struct hres *r)
+{
+	struct guest_audio_file *file = hobj_unwrap(A(0));
+	if (!file || !A(2)) { RET(kAudioFileNotOpenError); return; }
+	ExtAudioFileRef ext = NULL;
+	OSStatus status = ExtAudioFileWrapAudioFileID(file->file, A(1) != 0, &ext);
+	if (!status) W(A(2), 0) = hobj_wrap(ext);
+	RET(status);
+}
+
+static OSStatus w_ExtAudioFileGetProperty(ExtAudioFileRef ext, uint32_t property, UInt32 *size, void *out)
+{
+	switch (property) {
+	case kExtAudioFileProperty_FileDataFormat:
+	case kExtAudioFileProperty_ClientDataFormat:
+	case kExtAudioFileProperty_FileLengthFrames:
+		return ExtAudioFileGetProperty(ext, property, size, out);
+	default:
+		return kExtAudioFileError_InvalidProperty;
+	}
+}
+
+static OSStatus w_ExtAudioFileSetProperty(ExtAudioFileRef ext, uint32_t property, uint32_t size, const void *value)
+{
+	if (property != kExtAudioFileProperty_ClientDataFormat) return kExtAudioFileError_InvalidProperty;
+	return ExtAudioFileSetProperty(ext, property, size, value);
+}
+
+static void t_ExtAudioFileRead(uint32_t *args, struct hres *r)
+{
+	if (!A(1) || !A(2)) { RET(kExtAudioFileError_InvalidOperationOrder); return; }
+	g32 buffers = A(2);
+	UInt32 count = W(buffers, 0);
+	AudioBufferList *list = calloc(1, offsetof(AudioBufferList, mBuffers) + count * sizeof(AudioBuffer));
+	if (!list) { RET(kAudioFileUnspecifiedError); return; }
+	list->mNumberBuffers = count;
+	for (UInt32 i = 0; i < count; i++) {
+		g32 entry = buffers + 4 + i * 12;
+		list->mBuffers[i] = (AudioBuffer){ W(entry, 0), W(entry, 4), G2H(W(entry, 8)) };
+	}
+	OSStatus status = ExtAudioFileRead(hobj_unwrap(A(0)), G2H(A(1)), list);
+	if (!status) {
+		for (UInt32 i = 0; i < count; i++)
+			W(buffers + 4 + i * 12, 4) = list->mBuffers[i].mDataByteSize;
+	}
+	free(list);
+	RET(status);
+}
