+static void t_GetProcessInformation(uint32_t *args, struct hres *r)
+{
+	const ProcessSerialNumber *psn = G2H(A(0));
+	struct process_info32 *guest = G2H(A(1));
+	const uint32_t ordinary = offsetof(struct process_info32, temp_mem);
+	if (!psn || !guest || (guest->length != ordinary && guest->length != sizeof *guest)) {
+		RET(paramErr);
+		return;
+	}
+	Str31 name;
+	FSRef app;
+	ProcessInfoExtendedRec host = {
+		.processInfoLength = guest->length == ordinary ? sizeof(ProcessInfoRec) : sizeof host,
+		.processName = guest->name ? name : NULL,
+		.processAppRef = guest->app_spec ? &app : NULL,
+	};
+	OSErr status = GetProcessInformation(psn, (ProcessInfoRec *)&host);
+	if (status) { RET(status); return; }
+
+	extern void *guest_main_cfbundle(void);
+	Boolean self = psn->highLongOfPSN == 0 && psn->lowLongOfPSN == kCurrentProcess;
+	CFBundleRef bundle = self ? guest_main_cfbundle() : NULL;
+	if (bundle) {
+		CFBundleGetPackageInfo(bundle, &host.processType, &host.processSignature);
+		if (guest->name) {
+			const char *path = macho_image_name(0);
+			const char *leaf = path ? strrchr(path, '/') : NULL;
+			if (leaf) {
+				size_t length = strnlen(leaf + 1, sizeof name - 1);
+				name[0] = (unsigned char)length;
+				memcpy(name + 1, leaf + 1, length);
+			}
+		}
+		if (guest->app_spec) {
+			CFURLRef url = CFBundleCopyBundleURL(bundle);
+			if (url) {
+				CFURLGetFSRef(url, &app);
+				CFRelease(url);
+			}
+		}
+	}
+	if (guest->app_spec && (status = encode_process_spec(&app, guest->app_spec))) {
+		RET(status);
+		return;
+	}
+	if (guest->name) memcpy(G2H(guest->name), name, (size_t)name[0] + 1);
+	guest->number = host.processNumber;
+	guest->type = host.processType;
+	guest->signature = host.processSignature;
+	guest->mode = host.processMode;
+	guest->location = (uintptr_t)host.processLocation < LOW_END ? H2G(host.processLocation) : 0;
+	guest->size = host.processSize;
+	guest->free_mem = host.processFreeMem;
+	guest->launcher = host.processLauncher;
+	guest->launch_date = host.processLaunchDate;
+	guest->active_time = host.processActiveTime;
+	if (guest->length == sizeof *guest) {
+		guest->temp_mem = host.processTempMemTotal;
+		guest->purgeable_temp_mem = host.processPurgeableTempMemTotal;
+	}
+	RET(noErr);
+}
