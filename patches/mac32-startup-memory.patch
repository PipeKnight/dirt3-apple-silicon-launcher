+static void call_hi_constructor(ffi_cif *signature, void *result, void **args, void *context)
+{
+	const struct hi_constructor *bridge = context;
+	EventHandlerCallRef call = *(EventHandlerCallRef *)args[0];
+	EventRef event = *(EventRef *)args[1];
+	uintptr_t data = (uintptr_t)*(void **)args[2];
+	if (data >= LOW_END) die("HIObject callback data outside guest address space");
+	*(ffi_sarg *)result = (OSStatus)gcall(bridge->guest_handler, 3,
+		hobj_wrap(call), hobj_wrap(event), (g32)data);
+}
