+static OSErr encode_process_spec(const FSRef *ref, g32 out)
+{
+	FSCatalogInfo catalog = {0};
+	HFSUniStr255 name;
+	OSErr status = FSGetCatalogInfo(ref, kFSCatInfoVolume | kFSCatInfoParentDirID,
+		&catalog, &name, NULL, NULL);
+	if (status) return status;
+	CFStringRef string = CFStringCreateWithCharacters(NULL, name.unicode, name.length);
+	if (!string) return memFullErr;
+	unsigned char *spec = G2H(out);
+	Boolean ok = CFStringGetPascalString(string, spec + 6, 64, kCFStringEncodingMacRoman);
+	CFRelease(string);
+	if (!ok) return paramErr;
+	memcpy(spec, &catalog.volume, 2);
+	memcpy(spec + 2, &catalog.parentDirID, 4);
+	return noErr;
+}
+
+static void t_FSGetCatalogInfo(uint32_t *args, struct hres *r)
+{
+	FSCatalogInfo info = {0};
+	const FSRef *ref = G2H(A(0));
+	OSStatus status = FSGetCatalogInfo(ref, A(1), A(2) ? &info : NULL,
+		G2H(A(3)), NULL, G2H(A(5)));
+	if (status == noErr && A(4)) status = encode_process_spec(ref, A(4));
+	if (status == noErr && A(2)) {
+		// The packed i386 record has a 16-byte permission field, with
+		// a 32-bit FSFileSecurityRef in its last word.
+		unsigned char *out = G2H(A(2));
+		const size_t permissions = offsetof(FSCatalogInfo, permissions);
+		const size_t tail = offsetof(FSCatalogInfo, finderInfo);
+		g32 security = A(1) & kFSCatInfoFSFileSecurityRef ? hobj_wrap(info.permissions.fileSec) : 0;
+		memcpy(out, &info, permissions + 12);
+		memcpy(out + permissions + 12, &security, sizeof security);
+		memcpy(out + permissions + 16, (const unsigned char *)&info + tail, sizeof info - tail);
+	}
+	RET(status);
+}
