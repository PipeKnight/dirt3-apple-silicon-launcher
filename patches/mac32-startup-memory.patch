+static g32 w_CFBundleGetFunctionPointerForName(CFBundleRef bundle, CFStringRef function)
+{
+	char symbol[512] = "_";
+	if (!bundle || !function || !CFStringGetCString(function, symbol + 1, sizeof symbol - 1, kCFStringEncodingUTF8))
+		return 0;
+
+	// A native framework address cannot be called by the i386 guest.
+	// Return a typed thunk only when the requested bundle exports it.
+	g32 thunk = host_lookup(symbol);
+	if (thunk && CFBundleGetFunctionPointerForName(bundle, function))
+		return thunk;
+	LOG("CFBundle: no guest-callable function %s\n", symbol + 1);
+	return 0;
+}
+
+struct allocator32 {
+	uint32_t version;
+	g32 info, retain, release, description, allocate, reallocate, deallocate, preferred;
+};
+
+struct allocator_bridge {
+	struct allocator32 guest;
+	atomic_uint references;
+};
+
+static const void *retain_allocator_info(const void *info)
+{
+	struct allocator_bridge *bridge = (void *)info;
+	if (bridge->guest.retain)
+		bridge->guest.info = (g32)gcall(bridge->guest.retain, 1, bridge->guest.info);
+	atomic_fetch_add_explicit(&bridge->references, 1, memory_order_relaxed);
+	return bridge;
+}
+
+static void drop_allocator_bridge(struct allocator_bridge *bridge)
+{
+	if (atomic_fetch_sub_explicit(&bridge->references, 1, memory_order_acq_rel) == 1)
+		free(bridge);
+}
+
+static void release_allocator_info(const void *info)
+{
+	struct allocator_bridge *bridge = (void *)info;
+	if (bridge->guest.release)
+		gcall(bridge->guest.release, 1, bridge->guest.info);
+	drop_allocator_bridge(bridge);
+}
+
+static CFStringRef describe_allocator_info(const void *info)
+{
+	const struct allocator_bridge *bridge = info;
+	return hobj_unwrap((g32)gcall(bridge->guest.description, 1, bridge->guest.info));
+}
+
+static void *allocate_with_guest(CFIndex size, CFOptionFlags hint, void *info)
+{
+	const struct allocator_bridge *bridge = info;
+	if (size < 0 || size > INT32_MAX) return NULL;
+	return G2H(gcall(bridge->guest.allocate, 3, (uint32_t)size, (uint32_t)hint, bridge->guest.info));
+}
+
+static void *reallocate_with_guest(void *ptr, CFIndex size, CFOptionFlags hint, void *info)
+{
+	const struct allocator_bridge *bridge = info;
+	if ((uintptr_t)ptr >= LOW_END || size < 0 || size > INT32_MAX) return NULL;
+	return G2H(gcall(bridge->guest.reallocate, 4, H2G(ptr), (uint32_t)size,
+		(uint32_t)hint, bridge->guest.info));
+}
+
+static void deallocate_with_guest(void *ptr, void *info)
+{
+	const struct allocator_bridge *bridge = info;
+	if ((uintptr_t)ptr >= LOW_END) die("CFAllocator: pointer outside guest address space");
+	gcall(bridge->guest.deallocate, 2, H2G(ptr), bridge->guest.info);
+}
+
+static CFIndex preferred_guest_size(CFIndex size, CFOptionFlags hint, void *info)
+{
+	const struct allocator_bridge *bridge = info;
+	if (size < 0 || size > INT32_MAX) return size;
+	return (int32_t)gcall(bridge->guest.preferred, 3, (uint32_t)size,
+		(uint32_t)hint, bridge->guest.info);
+}
+
+static void t_CFAllocatorCreate(uint32_t *args, struct hres *r)
+{
+	const struct allocator32 *guest = G2H(A(1));
+	if (!guest || guest->version != 0 || !guest->allocate) { RET(0); return; }
+	struct allocator_bridge *bridge = malloc(sizeof *bridge);
+	if (!bridge) { RET(0); return; }
+	bridge->guest = *guest;
+	atomic_init(&bridge->references, 1);
+	CFAllocatorContext host = {
+		.version = 0,
+		.info = bridge,
+		.retain = retain_allocator_info,
+		.release = release_allocator_info,
+		.copyDescription = guest->description ? describe_allocator_info : NULL,
+		.allocate = allocate_with_guest,
+		.reallocate = guest->reallocate ? reallocate_with_guest : NULL,
+		.deallocate = guest->deallocate ? deallocate_with_guest : NULL,
+		.preferredSize = guest->preferred ? preferred_guest_size : NULL,
+	};
+	CFAllocatorRef allocator = CFAllocatorCreate(hobj_unwrap(A(0)), &host);
+	drop_allocator_bridge(bridge);
+	RET(hobj_wrap((void *)allocator));
+}
