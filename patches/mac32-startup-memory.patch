+struct guest_statfs {
+	int16_t old_type, old_flags;
+	int32_t block_size, io_size, blocks, free_blocks, available_blocks, files, free_files;
+	fsid_t fsid;
+	uint32_t owner;
+	int16_t subtype, type;
+	uint32_t flags, reserved2[2];
+	char type_name[15], mount_path[90], source_path[90];
+	char reserved3;
+	int32_t reserved4[4];
+};
+_Static_assert(sizeof(struct guest_statfs) == 272, "legacy i386 statfs size");
+
+static int32_t count_to_guest(uint64_t count, unsigned shift)
+{
+	if (count == UINT64_MAX) return -1;
+	count >>= shift;
+	return count > INT32_MAX ? INT32_MAX : (int32_t)count;
+}
+
+static int w_statfs(const char *path, struct guest_statfs *out)
+{
+	if (!out) { errno = EFAULT; return -1; }
+	struct statfs native;
+	int status = statfs(path, &native);
+	if (status) return status;
+
+	// As in Darwin's legacy interface, increase the reported block size
+	// when the actual block count does not fit in a signed 32-bit long.
+	uint64_t block_size = native.f_bsize;
+	unsigned shift = 0;
+	if (block_size && native.f_blocks != UINT64_MAX && native.f_bfree != UINT64_MAX &&
+	    native.f_bavail != UINT64_MAX) {
+		while ((native.f_blocks >> shift) > INT32_MAX && block_size <= INT32_MAX / 2) {
+			block_size *= 2;
+			++shift;
+		}
+	}
+	struct guest_statfs converted = {
+		.block_size = (int32_t)block_size, .io_size = native.f_iosize,
+		.blocks = count_to_guest(native.f_blocks, shift),
+		.free_blocks = count_to_guest(native.f_bfree, shift),
+		.available_blocks = count_to_guest(native.f_bavail, shift),
+		.files = (int32_t)native.f_files, .free_files = (int32_t)native.f_ffree,
+		.fsid = native.f_fsid, .owner = native.f_owner, .subtype = (int16_t)native.f_fssubtype,
+		.type = (int16_t)native.f_type, .flags = native.f_flags,
+	};
+	strlcpy(converted.type_name, native.f_fstypename, sizeof converted.type_name);
+	strlcpy(converted.mount_path, native.f_mntonname, sizeof converted.mount_path);
+	strlcpy(converted.source_path, native.f_mntfromname, sizeof converted.source_path);
+	memcpy(out, &converted, offsetof(struct guest_statfs, reserved3));
+	return 0;
+}
