index 0000000..4129d89
--- /dev/null
+++ b/src/malloc_zones.c
@@ -0,0 +1,257 @@
+// Guest malloc zones. Zone headers and function pointers use the i386 ABI.
+// mac32's own allocations always use its low heap directly.
+#include "thunks.h"
+#include <errno.h>
+#include <os/lock.h>
+#include <string.h>
+
+struct zone32 {
+	g32 reserved[2];
+	g32 size, malloc, calloc, valloc, free, realloc, destroy;
+	g32 name, batch_malloc, batch_free, introspect;
+	uint32_t version;
+	g32 memalign, free_definite_size;
+};
+_Static_assert(offsetof(struct zone32, version) == 52, "i386 malloc_zone_t version offset");
+
+static os_unfair_lock registry_lock = OS_UNFAIR_LOCK_INIT;
+static g32 builtin;
+static g32 initial_zones[4];
+static g32 *zones = initial_zones;
+static size_t zone_count, zone_capacity = sizeof initial_zones / sizeof initial_zones[0];
+
+// Calls made by a custom allocator to obtain its own backing storage use
+// the low heap. The host must never give a guest callback to libmalloc.
+static __thread unsigned inside_zone;
+
+static struct zone32 *zone_header(g32 zone)
+{
+	return G2H(zone);
+}
+
+static uint32_t invoke_zone(g32 callback, g32 zone, uint32_t a, uint32_t b)
+{
+	if (!callback) die("malloc: missing callback in guest zone %#x", zone);
+	inside_zone++;
+	uint32_t result = (uint32_t)gcall(callback, 3, zone, a, b);
+	inside_zone--;
+	return result;
+}
+
+static void register_zone(g32 zone)
+{
+	if (!zone) return;
+	os_unfair_lock_lock(&registry_lock);
+	for (size_t i = 0; i < zone_count; i++) {
+		if (zones[i] == zone) {
+			os_unfair_lock_unlock(&registry_lock);
+			return;
+		}
+	}
+	if (zone_count == zone_capacity) {
+		zone_capacity *= 2;
+		g32 *larger = malloc(zone_capacity * sizeof *larger);
+		if (!larger) die("malloc: cannot grow the guest zone registry");
+		memcpy(larger, zones, zone_count * sizeof *zones);
+		if (zones != initial_zones) free(zones);
+		zones = larger;
+	}
+	zones[zone_count++] = zone;
+	os_unfair_lock_unlock(&registry_lock);
+	LOG("malloc: registered guest zone %#x\n", zone);
+}
+
+static void unregister_zone(g32 zone)
+{
+	os_unfair_lock_lock(&registry_lock);
+	for (size_t i = 0; i < zone_count; i++) {
+		if (zones[i] == zone) {
+			zones[i] = zones[--zone_count];
+			break;
+		}
+	}
+	os_unfair_lock_unlock(&registry_lock);
+	LOG("malloc: unregistered guest zone %#x\n", zone);
+}
+
+static g32 default_zone(void)
+{
+	if (inside_zone) return builtin;
+	os_unfair_lock_lock(&registry_lock);
+	g32 zone = zone_count ? zones[0] : builtin;
+	os_unfair_lock_unlock(&registry_lock);
+	return zone;
+}
+
+static g32 allocation_zone(g32 ptr, uint32_t *size)
+{
+	*size = 0;
+	if (!ptr) return 0;
+
+	// Snapshot registrations and release the lock before entering any
+	// guest code. The caller of unregister owns the zone's lifetime.
+	g32 local[4];
+	g32 *snapshot = local;
+	size_t count = 0;
+	if (!inside_zone) {
+		os_unfair_lock_lock(&registry_lock);
+		count = zone_count;
+		if (count > sizeof local / sizeof local[0]) {
+			snapshot = malloc(count * sizeof *snapshot);
+			if (!snapshot) die("malloc: cannot copy the guest zone registry");
+		}
+		memcpy(snapshot, zones, count * sizeof *snapshot);
+		os_unfair_lock_unlock(&registry_lock);
+	}
+	g32 owner = 0;
+	for (size_t i = 0; i < count; i++) {
+		g32 zone = snapshot[i];
+		uint32_t n = zone == builtin ? gmalloc_query_size(ptr)
+			: invoke_zone(zone_header(zone)->size, zone, ptr, 0);
+		if (n) {
+			owner = zone;
+			*size = n;
+			break;
+		}
+	}
+	if (snapshot != local) free(snapshot);
+	if (!owner && (*size = gmalloc_query_size(ptr))) owner = builtin;
+	return owner;
+}
+
+static g32 zone_malloc(g32 zone, uint32_t n)
+{
+	return zone == builtin ? gmalloc(n) : invoke_zone(zone_header(zone)->malloc, zone, n, 0);
+}
+
+static g32 zone_calloc(g32 zone, uint32_t n, uint32_t size)
+{
+	if ((uint64_t)n * size > UINT32_MAX) return 0;
+	return zone == builtin ? gcalloc(n, size) : invoke_zone(zone_header(zone)->calloc, zone, n, size);
+}
+
+static g32 zone_valloc(g32 zone, uint32_t n)
+{
+	return zone == builtin ? gmemalign(4096, n) : invoke_zone(zone_header(zone)->valloc, zone, n, 0);
+}
+
+static void zone_free(g32 zone, g32 ptr)
+{
+	if (!ptr) return;
+	if (zone == builtin) gfree(ptr);
+	else invoke_zone(zone_header(zone)->free, zone, ptr, 0);
+}
+
+static g32 zone_realloc(g32 zone, g32 ptr, uint32_t n)
+{
+	return zone == builtin ? grealloc(ptr, n) : invoke_zone(zone_header(zone)->realloc, zone, ptr, n);
+}
+
+static g32 zone_memalign(g32 zone, uint32_t align, uint32_t n)
+{
+	if (align < sizeof(g32) || (align & (align - 1)) || (uint64_t)n + align + 0x2010 > UINT32_MAX)
+		return 0;
+	if (zone == builtin) return gmemalign(align, n);
+	struct zone32 *header = zone_header(zone);
+	return header->version >= 5 && header->memalign
+		? invoke_zone(header->memalign, zone, align, n) : 0;
+}
+
+static g32 app_malloc(uint32_t n) { return zone_malloc(default_zone(), n); }
+static g32 app_calloc(uint32_t n, uint32_t size) { return zone_calloc(default_zone(), n, size); }
+static g32 app_valloc(uint32_t n) { return zone_valloc(default_zone(), n); }
+g32 guest_memalign(uint32_t align, uint32_t n) { return zone_memalign(default_zone(), align, n); }
+
+static void app_free(g32 ptr)
+{
+	if (!ptr) return;
+	if (default_zone() == builtin && !inside_zone) {
+		// The common case uses the old low-heap path while only mac32's zone is registered.
+		os_unfair_lock_lock(&registry_lock);
+		int only_builtin = zone_count == 1 && zones[0] == builtin;
+		os_unfair_lock_unlock(&registry_lock);
+		if (only_builtin) { gfree(ptr); return; }
+	}
+	uint32_t size;
+	g32 owner = allocation_zone(ptr, &size);
+	if (!owner) die("free: no guest zone owns %#x", ptr);
+	zone_free(owner, ptr);
+}
+
+static g32 app_realloc(g32 ptr, uint32_t n)
+{
+	if (!ptr) return app_malloc(n);
+	uint32_t size;
+	g32 owner = allocation_zone(ptr, &size);
+	if (!owner) die("realloc: no guest zone owns %#x", ptr);
+	return zone_realloc(owner, ptr, n);
+}
+
+static uint32_t app_size(g32 ptr)
+{
+	uint32_t size;
+	allocation_zone(ptr, &size);
+	return size;
+}
+
+static g32 zone_from_ptr(g32 ptr)
+{
+	uint32_t size;
+	return allocation_zone(ptr, &size);
+}
+
+static uint32_t low_size(g32 zone, g32 ptr) { return gmalloc_query_size(ptr); }
+static g32 low_malloc(g32 zone, uint32_t n) { return gmalloc(n); }
+static g32 low_calloc(g32 zone, uint32_t n, uint32_t size) { return gcalloc(n, size); }
+static g32 low_valloc(g32 zone, uint32_t n) { return gmemalign(4096, n); }
+static void low_heap_free(g32 zone, g32 ptr) { gfree(ptr); }
+static g32 low_realloc(g32 zone, g32 ptr, uint32_t n) { return grealloc(ptr, n); }
+static g32 low_memalign(g32 zone, uint32_t align, uint32_t n) { return zone_memalign(builtin, align, n); }
+static void low_free_sized(g32 zone, g32 ptr, uint32_t size) { gfree(ptr); }
+
+static struct hfn builtin_callbacks[] = {
+	G("builtin zone size", low_size, "u:uu"),
+	G("builtin zone malloc", low_malloc, "u:uu"),
+	G("builtin zone calloc", low_calloc, "u:uuu"),
+	G("builtin zone valloc", low_valloc, "u:uu"),
+	G("builtin zone free", low_heap_free, "v:uu"),
+	G("builtin zone realloc", low_realloc, "u:uuu"),
+	G("builtin zone memalign", low_memalign, "u:uuu"),
+	G("builtin zone free_definite_size", low_free_sized, "v:uuu"),
+};
+
+static struct hfn entries[] = {
+	G("_malloc", app_malloc, "u:u"), G("_calloc", app_calloc, "u:uu"),
+	G("_realloc", app_realloc, "u:uu"), G("_free", app_free, "v:u"),
+	G("_malloc_size", app_size, "u:u"), G("_valloc", app_valloc, "u:u"),
+	G("_memalign", guest_memalign, "u:uu"),
+	G("_malloc_default_zone", default_zone, "u:"),
+	G("_malloc_zone_register", register_zone, "v:u"),
+	G("_malloc_zone_unregister", unregister_zone, "v:u"),
+	G("_malloc_zone_from_ptr", zone_from_ptr, "u:u"),
+	G("_malloc_zone_malloc", zone_malloc, "u:uu"),
+	G("_malloc_zone_calloc", zone_calloc, "u:uuu"),
+	G("_malloc_zone_valloc", zone_valloc, "u:uu"),
+	G("_malloc_zone_free", zone_free, "v:uu"),
+	G("_malloc_zone_realloc", zone_realloc, "u:uuu"),
+	G("_malloc_zone_memalign", zone_memalign, "u:uuu"),
+};
+
+void thunks_malloc_zones_init(void)
+{
+	builtin = gcalloc(1, sizeof(struct zone32));
+	*zone_header(builtin) = (struct zone32){
+		.size = hfn_stub(&builtin_callbacks[0]),
+		.malloc = hfn_stub(&builtin_callbacks[1]),
+		.calloc = hfn_stub(&builtin_callbacks[2]),
+		.valloc = hfn_stub(&builtin_callbacks[3]),
+		.free = hfn_stub(&builtin_callbacks[4]),
+		.realloc = hfn_stub(&builtin_callbacks[5]),
+		.name = gstrdup("mac32 low heap"),
+		.version = 6,
+		.memalign = hfn_stub(&builtin_callbacks[6]),
+		.free_definite_size = hfn_stub(&builtin_callbacks[7]),
+	};
+	register_zone(builtin);
+	REGISTER(entries);
+}
