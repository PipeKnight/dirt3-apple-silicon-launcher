+// A dedicated sparse arena implements the guest process break. Keep it
+// separate from mac32's heap and commit pages only as the break grows.
+g32 guest_sbrk(int32_t delta)
+{
+	const uint32_t capacity = 64u * 1024 * 1024;
+	static os_unfair_lock break_lock = OS_UNFAIR_LOCK_INIT;
+	static g32 base;
+	static uint32_t used;
+
+	os_unfair_lock_lock(&break_lock);
+	int64_t next = (int64_t)used + delta;
+	if (next < 0 || next > capacity) {
+		os_unfair_lock_unlock(&break_lock);
+		errno = ENOMEM;
+		return UINT32_MAX;
+	}
+	if (!base) base = low_pages(capacity, PROT_NONE);
+	uint32_t old_pages = (used + 0xfffu) & ~0xfffu;
+	uint32_t next_pages = ((uint32_t)next + 0xfffu) & ~0xfffu;
+	if (next_pages > old_pages)
+		low_commit(base + old_pages, next_pages - old_pages, PROT_READ | PROT_WRITE);
+	else if (next_pages < old_pages)
+		low_commit(base + next_pages, old_pages - next_pages, PROT_NONE);
+
+	g32 old_break = base + used;
+	used = (uint32_t)next;
+	os_unfair_lock_unlock(&break_lock);
+	return old_break;
+}
