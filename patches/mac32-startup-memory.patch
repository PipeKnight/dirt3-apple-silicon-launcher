diff --git a/src/carbon_windows.m b/src/carbon_windows.m
new file mode 100644
index 0000000..1997423
--- /dev/null
+++ b/src/carbon_windows.m
@@ -0,0 +1,221 @@
+// Carbon window handles for Cocoa windows on hosts without WindowRef.
+#import <AppKit/AppKit.h>
+#import <Carbon/Carbon.h>
+#import <objc/runtime.h>
+#include "thunks.h"
+
+static NSWindow *cocoa_window(void *handle)
+{
+	id object = (id)handle;
+	return [object isKindOfClass:[NSWindow class]] ? object : nil;
+}
+
+static NSWindow *w_GetNextWindow(void *handle)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window) return nil;
+	NSArray<NSWindow *> *windows = [NSApp orderedWindows];
+	NSUInteger index = [windows indexOfObjectIdenticalTo:window];
+	return index != NSNotFound && index + 1 < windows.count ? windows[index + 1] : nil;
+}
+
+static void w_ShowWindow(void *handle) { [cocoa_window(handle) orderFront:nil]; }
+static void w_HideWindow(void *handle) { [cocoa_window(handle) orderOut:nil]; }
+
+static OSStatus w_GetWindowClass(void *handle, uint32_t *result)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window || !result) return paramErr;
+	if (window.sheetParent) *result = kSheetWindowClass;
+	else if ([window isKindOfClass:[NSPanel class]]) *result = kUtilityWindowClass;
+	else if (window.styleMask & NSWindowStyleMaskTitled) *result = kDocumentWindowClass;
+	else *result = kPlainWindowClass;
+	return noErr;
+}
+
+static OSStatus w_GetWindowAttributes(void *handle, uint32_t *result)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window || !result) return paramErr;
+	NSWindowStyleMask style = window.styleMask;
+	uint32_t attributes = kWindowCompositingAttribute;
+	if (style & NSWindowStyleMaskClosable) attributes |= kWindowCloseBoxAttribute;
+	if (style & NSWindowStyleMaskMiniaturizable) attributes |= kWindowCollapseBoxAttribute;
+	if (style & NSWindowStyleMaskResizable) attributes |= kWindowResizableAttribute | kWindowFullZoomAttribute;
+	if (!(style & NSWindowStyleMaskTitled)) attributes |= kWindowNoTitleBarAttribute;
+	*result = attributes;
+	return noErr;
+}
+
+static OSStatus w_GetRootControl(void *handle, void **control)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window || !control) return paramErr;
+	*control = window.contentView;
+	return *control ? noErr : errNoRootControl;
+}
+
+static NSView *w_HIViewGetRoot(void *handle)
+{
+	return cocoa_window(handle).contentView;
+}
+
+static OSStatus w_SetAutomaticControlDragTrackingEnabledForWindow(void *handle, uint32_t enabled)
+{
+	// Cocoa registers drag destinations on its views. Carbon's automatic
+	// control tracking cannot be enabled for an AppKit window.
+	if (!cocoa_window(handle)) return paramErr;
+	return enabled ? unimpErr : noErr;
+}
+
+static OSStatus w_SetThemeWindowBackground(void *handle, int32_t brush, uint32_t update)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window) return paramErr;
+	CGColorRef color = NULL;
+	OSStatus status = HIThemeBrushCreateCGColor((ThemeBrush)brush, &color);
+	if (status == noErr && color) {
+		window.backgroundColor = [NSColor colorWithCGColor:color];
+		if (update) [window.contentView setNeedsDisplay:YES];
+		CGColorRelease(color);
+	}
+	return status;
+}
+
+static OSStatus carbon_window_target_lifecycle(EventHandlerCallRef call, EventRef event, void *context)
+{
+	if (GetEventKind(event) == kEventHIObjectConstruct)
+		return SetEventParameter(event, kEventParamHIObjectInstance, typeVoidPtr, sizeof context, &context);
+	return noErr;
+}
+
+static EventTargetRef carbon_target(id owner)
+{
+	if (!owner) return NULL;
+	static char target_key;
+	HIObjectRef object = (HIObjectRef)objc_getAssociatedObject(owner, &target_key);
+	if (!object) {
+		static dispatch_once_t once;
+		static OSStatus status;
+		CFStringRef class_id = CFSTR("com.khesin.mac32.CarbonWindowTarget");
+		dispatch_once(&once, ^{
+			const EventTypeSpec types[] = {
+				{kEventClassHIObject, kEventHIObjectConstruct},
+				{kEventClassHIObject, kEventHIObjectDestruct},
+			};
+			status = HIObjectRegisterSubclass(class_id, NULL, 0, carbon_window_target_lifecycle, 2, types,
+				NULL, NULL);
+		});
+		if (status != noErr || HIObjectCreate(class_id, NULL, &object) != noErr)
+			return NULL;
+		objc_setAssociatedObject(owner, &target_key, (id)object, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+		CFRelease(object);
+	}
+	return HIObjectGetEventTarget(object);
+}
+
+static EventTargetRef w_GetWindowEventTarget(void *handle)
+{
+	return carbon_target(cocoa_window(handle));
+}
+
+static EventTargetRef w_GetControlEventTarget(id control)
+{
+	return [control isKindOfClass:[NSView class]] ? carbon_target(control) : NULL;
+}
+
+static NSMutableDictionary *properties(id owner)
+{
+	static char key;
+	NSMutableDictionary *values = objc_getAssociatedObject(owner, &key);
+	if (!values) {
+		values = [NSMutableDictionary dictionary];
+		objc_setAssociatedObject(owner, &key, values, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+	}
+	return values;
+}
+
+static NSNumber *property_id(uint32_t creator, uint32_t tag)
+{
+	return @(((uint64_t)creator << 32) | tag);
+}
+
+static OSStatus w_SetControlProperty(id control, uint32_t creator, uint32_t tag,
+	uint32_t size, const void *data)
+{
+	if (![control isKindOfClass:[NSView class]]) return controlHandleInvalidErr;
+	if (size && !data) return paramErr;
+	properties(control)[property_id(creator, tag)] = [NSData dataWithBytes:data length:size];
+	return noErr;
+}
+
+static OSStatus read_property(id owner, uint32_t creator, uint32_t tag, uint32_t capacity,
+	uint32_t *size, void *data, OSStatus missing)
+{
+	NSData *value = properties(owner)[property_id(creator, tag)];
+	if (!value) return missing;
+	if (size) *size = (uint32_t)value.length;
+	if (!capacity) return data && value.length ? paramErr : noErr;
+	if (!data) return paramErr;
+	size_t count = capacity < value.length ? capacity : value.length;
+	if (count) memcpy(data, value.bytes, count);
+	return capacity == value.length ? noErr : paramErr;
+}
+
+static OSStatus w_GetControlProperty(id control, uint32_t creator, uint32_t tag,
+	uint32_t capacity, uint32_t *size, void *data)
+{
+	if (![control isKindOfClass:[NSView class]]) return controlHandleInvalidErr;
+	return read_property(control, creator, tag, capacity, size, data, controlPropertyNotFoundErr);
+}
+
+static OSStatus w_GetControlPropertySize(id control, uint32_t creator, uint32_t tag, uint32_t *size)
+{
+	if (!size) return paramErr;
+	return w_GetControlProperty(control, creator, tag, 0, size, NULL);
+}
+
+static OSStatus w_RemoveControlProperty(id control, uint32_t creator, uint32_t tag)
+{
+	if (![control isKindOfClass:[NSView class]]) return controlHandleInvalidErr;
+	[properties(control) removeObjectForKey:property_id(creator, tag)];
+	return noErr;
+}
+
+static OSStatus w_GetWindowProperty(void *handle, uint32_t creator, uint32_t tag,
+	uint32_t capacity, uint32_t *size, void *data)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window) return paramErr;
+	return read_property(window, creator, tag, capacity, size, data, errWindowPropertyNotFound);
+}
+
+static OSStatus w_RemoveWindowProperty(void *handle, uint32_t creator, uint32_t tag)
+{
+	NSWindow *window = cocoa_window(handle);
+	if (!window) return paramErr;
+	[properties(window) removeObjectForKey:property_id(creator, tag)];
+	return noErr;
