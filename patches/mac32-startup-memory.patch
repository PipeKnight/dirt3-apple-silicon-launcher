+++ b/src/apple_events.c
@@ -0,0 +1,179 @@
+#include <Carbon/Carbon.h>
+#include <stdlib.h>
+
+#include "thunks.h"
+
+struct ae_desc32 {
+	uint32_t type;
+	g32 handle;
+} __attribute__((packed, aligned(2)));
+
+static AEDesc ae_read(g32 addr)
+{
+	const struct ae_desc32 *desc = G2H(addr);
+	return desc ? (AEDesc){desc->type, hobj_unwrap(desc->handle)} : (AEDesc){typeNull, NULL};
+}
+
+static void ae_write(g32 addr, const AEDesc *host)
+{
+	struct ae_desc32 *desc = G2H(addr);
+	if (desc) *desc = (struct ae_desc32){host->descriptorType, hobj_wrap(host->dataHandle)};
+}
+
+struct ae_handler {
+	struct ae_handler *next;
+	uint32_t event_class, event_id;
+	Boolean system;
+	g32 function, refcon;
+};
+
+static struct ae_handler *handlers;
+
+static OSErr call_ae_handler(const AppleEvent *event, AppleEvent *reply, SRefCon refcon)
+{
+	const struct ae_handler *handler = (void *)(uintptr_t)refcon;
+	g32 input = gmalloc(2 * sizeof(struct ae_desc32));
+	g32 output = reply ? input + sizeof(struct ae_desc32) : 0;
+	ae_write(input, event);
+	ae_write(output, reply);
+	OSErr status = (OSErr)gcall(handler->function, 3, input, output, handler->refcon);
+	if (reply) *reply = ae_read(output);
+	gfree(input);
+	return status;
+}
+
+static struct ae_handler **find_ae_handler(uint32_t event_class, uint32_t event_id, Boolean system)
+{
+	struct ae_handler **slot = &handlers;
+	while (*slot && ((*slot)->event_class != event_class || (*slot)->event_id != event_id ||
+		(*slot)->system != system)) {
+		slot = &(*slot)->next;
+	}
+	return slot;
+}
+
+static void t_AEInstallEventHandler(uint32_t *args, struct hres *r)
+{
+	if (!A(2)) { RET(paramErr); return; }
+	Boolean system = A(4) != 0;
+	struct ae_handler **slot = find_ae_handler(A(0), A(1), system);
+	struct ae_handler *handler = calloc(1, sizeof(*handler));
+	if (!handler) { RET(memFullErr); return; }
+	*handler = (struct ae_handler){NULL, A(0), A(1), system, A(2), A(3)};
+	OSErr status = AEInstallEventHandler(A(0), A(1), call_ae_handler,
+		(SRefCon)(uintptr_t)handler, system);
+	if (status == noErr) {
+		struct ae_handler *previous = *slot;
+		handler->next = previous ? previous->next : NULL;
+		*slot = handler;
+		free(previous);
+	} else {
+		free(handler);
+	}
+	RET(status);
+}
+
+static void t_AERemoveEventHandler(uint32_t *args, struct hres *r)
+{
+	Boolean system = A(3) != 0;
+	struct ae_handler **slot = find_ae_handler(A(0), A(1), system);
+	struct ae_handler *handler = *slot;
+	if (!handler || handler->function != A(2)) { RET(errAEHandlerNotFound); return; }
+	OSErr status = AERemoveEventHandler(A(0), A(1), call_ae_handler, system);
+	if (status == noErr) {
+		*slot = handler->next;
+		free(handler);
+	}
+	RET(status);
+}
+
+static void t_AECreateDesc(uint32_t *args, struct hres *r)
+{
+	AEDesc output = {typeNull, NULL};
+	OSErr status = AECreateDesc(A(0), G2H(A(1)), (int32_t)A(2), A(3) ? &output : NULL);
+	ae_write(A(3), &output);
+	RET(status);
+}
+
+static void t_AEDisposeDesc(uint32_t *args, struct hres *r)
+{
+	AEDesc desc = ae_read(A(0));
+	OSErr status = AEDisposeDesc(A(0) ? &desc : NULL);
+	ae_write(A(0), &desc);
+	RET(status);
+}
+
+static void t_AECreateAppleEvent(uint32_t *args, struct hres *r)
+{
+	AEDesc target = ae_read(A(2));
+	AppleEvent output = {typeNull, NULL};
+	OSErr status = AECreateAppleEvent(A(0), A(1), A(2) ? &target : NULL, (AEReturnID)A(3),
+		(AETransactionID)A(4), A(5) ? &output : NULL);
+	ae_write(A(5), &output);
+	RET(status);
+}
+
+static void t_AECoerceDesc(uint32_t *args, struct hres *r)
+{
+	AEDesc desc = ae_read(A(0)), output = {typeNull, NULL};
+	OSErr status = AECoerceDesc(A(0) ? &desc : NULL, A(1), A(2) ? &output : NULL);
+	ae_write(A(2), &output);
+	RET(status);
+}
+
+static void t_AEGetDescData(uint32_t *args, struct hres *r)
+{
+	AEDesc desc = ae_read(A(0));
+	RET(AEGetDescData(A(0) ? &desc : NULL, G2H(A(1)), (int32_t)A(2)));
+}
+
+static void t_AEGetDescDataSize(uint32_t *args, struct hres *r)
+{
+	AEDesc desc = ae_read(A(0));
+	RET(AEGetDescDataSize(A(0) ? &desc : NULL));
+}
+
+static void t_AECountItems(uint32_t *args, struct hres *r)
+{
+	AEDesc desc = ae_read(A(0));
+	long count;
+	OSErr status = AECountItems(A(0) ? &desc : NULL, A(1) ? &count : NULL);
+	if (status == noErr && A(1)) *(int32_t *)G2H(A(1)) = (int32_t)count;
+	RET(status);
+}
+
+static void t_AEGetNthDesc(uint32_t *args, struct hres *r)
+{
+	AEDesc desc = ae_read(A(0)), output = {typeNull, NULL};
+	OSErr status = AEGetNthDesc(A(0) ? &desc : NULL, (int32_t)A(1), A(2), G2H(A(3)),
+		A(4) ? &output : NULL);
+	ae_write(A(4), &output);
+	RET(status);
+}
+
+static void t_AEGetParamDesc(uint32_t *args, struct hres *r)
+{
+	AEDesc event = ae_read(A(0)), output = {typeNull, NULL};
+	OSErr status = AEGetParamDesc(A(0) ? &event : NULL, A(1), A(2), A(3) ? &output : NULL);
+	ae_write(A(3), &output);
+	RET(status);
+}
+
+static void t_AEPutParamPtr(uint32_t *args, struct hres *r)
+{
+	AEDesc event = ae_read(A(0));
+	OSErr status = AEPutParamPtr(A(0) ? &event : NULL, A(1), A(2), G2H(A(3)), (int32_t)A(4));
+	ae_write(A(0), &event);
+	RET(status);
+}
+
+static struct hfn apple_events_fns[] = {
+	R("_AEInstallEventHandler", t_AEInstallEventHandler), R("_AERemoveEventHandler", t_AERemoveEventHandler),
+	R("_AECreateDesc", t_AECreateDesc), R("_AEDisposeDesc", t_AEDisposeDesc),
+	R("_AECreateAppleEvent", t_AECreateAppleEvent), R("_AECoerceDesc", t_AECoerceDesc),
+	R("_AEGetDescData", t_AEGetDescData), R("_AEGetDescDataSize", t_AEGetDescDataSize),
+	R("_AECountItems", t_AECountItems), R("_AEGetNthDesc", t_AEGetNthDesc),
+	R("_AEGetParamDesc", t_AEGetParamDesc), R("_AEPutParamPtr", t_AEPutParamPtr),
+};
+
+void thunks_apple_events_init(void) { REGISTER(apple_events_fns); }
