+
+CFArrayRef w_CFBundleCopyPreferredLocalizationsFromArray(CFArrayRef localizations)
+{
+	// Feral saves the Steam language as AppleLanguages in the runtime app's
+	// preferences. Core Foundation can still resolve against the host's
+	// language list, so give it the saved preference explicitly for DiRT 3.
+	if (dirt3_version_patch_active() && localizations) {
+		CFPropertyListRef languages = CFPreferencesCopyValue(
+		    CFSTR("AppleLanguages"), kCFPreferencesCurrentApplication,
+		    kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
+		if (languages) {
+			CFArrayRef preference = CFGetTypeID(languages) == CFArrayGetTypeID()
+			    ? (CFArrayRef)languages : NULL;
+			CFIndex count = preference ? CFArrayGetCount(preference) : 0;
+			CFIndex index = 0;
+			while (index < count &&
+			       CFGetTypeID(CFArrayGetValueAtIndex(preference, index)) == CFStringGetTypeID())
+				index++;
+			CFArrayRef result = count && index == count
+			    ? CFBundleCopyLocalizationsForPreferences(localizations, preference) : NULL;
+			CFRelease(languages);
+			if (result) return result;
+		}
+	}
+	return CFBundleCopyPreferredLocalizationsFromArray(localizations);
+}
