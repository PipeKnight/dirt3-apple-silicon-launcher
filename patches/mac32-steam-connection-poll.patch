+// Coalesce the game's repeated connectivity queries at one validated call site.
+static void steam_connection_status(struct hfn *h, void *self, void *fn, uint32_t *args, struct hres *r)
+{
+	static _Thread_local struct {
+		void *user;
+		uint64_t valid_until;
+		uint32_t generation;
+		uint64_t value;
+	} recent;
+	uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+	uint32_t generation = atomic_load_explicit(&connection_generation, memory_order_acquire);
+	if (recent.user == self && recent.generation == generation && now < recent.valid_until) {
+		r->rax = recent.value;
+		return;
+	}
+	const struct smethod *m = h->ctx;
+	call_sig(fn, m->sig, h->name, args, r);
+	recent.user = self;
+	recent.generation = generation;
+	recent.value = r->rax;
+	recent.valid_until = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 100000000;
+}
