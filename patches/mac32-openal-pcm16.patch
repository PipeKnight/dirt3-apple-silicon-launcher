diff --git a/patches/dirt3_pcm16.c b/patches/dirt3_pcm16.c
new file mode 100644
index 0000000..1d70072
--- /dev/null
+++ b/patches/dirt3_pcm16.c
@@ -0,0 +1,110 @@
+#include "../src/patches.h"
+#include <string.h>
+
+extern int macho_section(struct image *, const char *, const char *, g32 *, uint32_t *);
+
+static void copy_signed_pcm16(uint32_t *args, struct hres *r)
+{
+    (void)r;
+    const uintptr_t dst_addr = A(0), src_addr = A(1);
+    const size_t size = (size_t)A(2) * A(3) * sizeof(uint16_t);
+    if (!size || dst_addr == src_addr)
+        return;
+
+    uint8_t *dst = G2H(dst_addr);
+    const uint8_t *src = G2H(src_addr);
+    if (dst_addr < src_addr ? src_addr - dst_addr >= size : dst_addr - src_addr >= size) {
+        memcpy(dst, src, size);
+        return;
+    }
+
+    // The i386 conversion originally visits interleaved samples in order.
+    // Keep its forward-copy semantics if the caller provides overlapping memory.
+    for (size_t offset = 0; offset < size; offset += sizeof(uint16_t)) {
+        uint16_t sample;
+        memcpy(&sample, src + offset, sizeof sample);
+        memcpy(dst + offset, &sample, sizeof sample);
+    }
+}
+
+static struct hfn copy_pcm16_thunk = R("DiRT 3 OpenAL signed PCM16 copy", copy_signed_pcm16);
+
+struct pcm16_copy_site {
+    g32 offset, return_offset;
+    uint8_t source_offset, destination_offset, canary_offset;
+    uint8_t branch[32];
+};
+
+static const struct pcm16_copy_site pcm16_sites[] = {
+    { // OpenAL shipped with the Steam Mac edition
+        .offset = 0x2e16, .return_offset = 0xade4,
+        .source_offset = 0xc4, .destination_offset = 0xe4, .canary_offset = 0xc0,
+        .branch = {
+            0x83, 0x7d, 0x14, 0x00, 0x0f, 0x84, 0xc4, 0x7f, 0x00, 0x00,
+            0x8b, 0x45, 0x10, 0x8d, 0x40, 0xff, 0x89, 0x85, 0x98, 0xfa, 0xff, 0xff,
+            0xc7, 0x85, 0xe8, 0xfa, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
+        },
+    },
+    { // OpenAL shipped with the standalone Mac edition
+        .offset = 0x121f, .return_offset = 0x6052,
+        .source_offset = 0xec, .destination_offset = 0xf0, .canary_offset = 0xb8,
+        .branch = {
+            0x83, 0x7d, 0x14, 0x00, 0x0f, 0x84, 0x29, 0x4e, 0x00, 0x00,
+            0x31, 0xc0, 0x85, 0xd2, 0x89, 0xd1, 0x89, 0xd3,
+            0x8b, 0x95, 0xf0, 0xfa, 0xff, 0xff, 0x8b, 0xb5, 0xec, 0xfa, 0xff, 0xff, 0x75, 0x04,
+        },
+    },
+};
+
+static int patch_pcm16_branch(g32 convert, uint32_t code_size, const struct pcm16_copy_site *layout)
+{
+    const g32 site = convert + layout->offset;
+    const g32 finish = convert + layout->return_offset;
+    const uint8_t epilogue[] = {0x8b, 0x85, layout->canary_offset, 0xfa, 0xff, 0xff, 0x8b, 0x00};
+    if (code_size < layout->return_offset + sizeof epilogue ||
+        memcmp(G2H(site), layout->branch, sizeof layout->branch) ||
+        memcmp(G2H(finish), epilogue, sizeof epilogue))
+        return 0;
+
+    // Signed 16-bit input and output share the same contiguous sample layout.
+    // Pass both pointers, samples per frame and frame count to the bridge.
+    uint8_t replacement[] = {
+        0xff, 0x75, 0x14,                                      // pushl frame count
+        0xff, 0x75, 0x10,                                      // pushl samples per frame
+        0xff, 0xb5, layout->source_offset, 0xfa, 0xff, 0xff,   // pushl source
+        0xff, 0xb5, layout->destination_offset, 0xfa, 0xff, 0xff,
+        0xe8, 0, 0, 0, 0,                                     // call bridge
+        0x83, 0xc4, 0x10,                                      // discard arguments
+        0xe9, 0, 0, 0, 0,                                     // jump to normal epilogue
+    };
+    _Static_assert(sizeof replacement <= sizeof layout->branch, "OpenAL patch exceeds validated instructions");
+    const uint32_t call = hfn_stub(&copy_pcm16_thunk) - (site + 23);
+    const uint32_t jump = finish - (site + 31);
+    memcpy(replacement + 19, &call, sizeof call);
+    memcpy(replacement + 27, &jump, sizeof jump);
+    memcpy(G2H(site), replacement, sizeof replacement);
+    return 1;
+}
+
+static int optimize_pcm16_copy(struct image *image)
+{
+    const g32 convert = macho_local_sym(image, "_ConvertData");
+    g32 text;
+    uint32_t size;
+    if (!convert || !macho_section(image, "__TEXT", "__text", &text, &size) ||
+        convert < text || convert - text >= size)
+        return 0;
+
+    const uint32_t code_size = size - (convert - text);
+    for (size_t i = 0; i < sizeof pcm16_sites / sizeof pcm16_sites[0]; i++)
+        if (patch_pcm16_branch(convert, code_size, &pcm16_sites[i]))
+            return 1;
+    return 0;
+}
+
+const struct guest_patch patch_dirt3_pcm16 = {
+    .library = "libopenal-soft-1.15.1.dylib",
+    .game = "DiRT 3",
+    .what = "bulk copy for matching signed PCM16 formats",
+    .apply = optimize_pcm16_copy,
+};
