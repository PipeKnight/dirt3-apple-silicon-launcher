+
+// Use the two 16-bit motor amplitudes described by the SDL Stadia driver.
+static IOReturn send_stadia_rumble(IOHIDDeviceRef device, uint16_t low, uint16_t high)
+{
+    enum { report_id = 5 };
+    const uint8_t report[] = {report_id, low & 0xff, low >> 8, high & 0xff, high >> 8};
+    return IOHIDDeviceSetReport(device, kIOHIDReportTypeOutput, report_id, report, sizeof(report));
+}
+
+static os_unfair_lock stadia_lock = OS_UNFAIR_LOCK_INIT;
+static IOHIDDeviceRef stadia_output;
+static uint16_t stadia_low, stadia_high;
+static double stadia_retry_at;
+
+static void close_stadia_output(void)
+{
+    if (!stadia_output) return;
+    send_stadia_rumble(stadia_output, 0, 0);
+    IOHIDDeviceClose(stadia_output, kIOHIDOptionsTypeNone);
+    CFRelease(stadia_output);
+    stadia_output = NULL;
+    stadia_low = stadia_high = 0;
+}
+
+static void stop_stadia_rumble(void)
+{
+    os_unfair_lock_lock(&stadia_lock);
+    close_stadia_output();
+    os_unfair_lock_unlock(&stadia_lock);
+}
+
+static void update_stadia_rumble(IOHIDDeviceRef device, const float strength[2], double time)
+{
+    uint16_t low = (uint16_t)lroundf(strength[0] * UINT16_MAX);
+    uint16_t high = (uint16_t)lroundf(strength[1] * UINT16_MAX);
+    os_unfair_lock_lock(&stadia_lock);
+    if (device != stadia_output) close_stadia_output();
+    if (device && !stadia_output && (low || high) && time >= stadia_retry_at) {
+        IOReturn result = IOHIDDeviceOpen(device, kIOHIDOptionsTypeNone);
+        if (result == kIOReturnSuccess) {
+            stadia_output = (IOHIDDeviceRef)CFRetain(device);
+            LOG("DiRT 3 Stadia rumble ready\n");
+        } else {
+            LOG("DiRT 3 Stadia rumble: open failed (0x%x)\n", result);
+            stadia_retry_at = time + 2;
+        }
+    }
+    if (stadia_output && (low != stadia_low || high != stadia_high)) {
+        IOReturn result = send_stadia_rumble(stadia_output, low, high);
+        if (result == kIOReturnSuccess) {
+            stadia_low = low;
+            stadia_high = high;
+            if (trace_enabled) LOG("DiRT 3 Stadia rumble sent: low=%u high=%u\n", low, high);
+        } else {
+            LOG("DiRT 3 Stadia rumble: report failed (0x%x)\n", result);
+            close_stadia_output();
+            stadia_retry_at = time + 2;
+        }
+    }
+    os_unfair_lock_unlock(&stadia_lock);
 }
 
