+static CFNumberRef copy_stadia_location(GCController *controller, CFStringRef *matched_transport)
+{
+    if (![controller.vendorName localizedCaseInsensitiveContainsString:@"Stadia"]) return NULL;
+    IOHIDManagerRef manager = IOHIDManagerCreate(NULL, kIOHIDOptionsTypeNone);
+    if (!manager) return NULL;
+    IOHIDManagerSetDeviceMatching(manager, (CFDictionaryRef)@{
+        @kIOHIDVendorIDKey: @(DIRT3_STADIA_VENDOR), @kIOHIDProductIDKey: @(DIRT3_STADIA_PRODUCT),
+        @kIOHIDPrimaryUsagePageKey: @1, @kIOHIDPrimaryUsageKey: @5,
+    });
+    CFSetRef devices = IOHIDManagerCopyDevices(manager);
+    CFNumberRef location = NULL;
+    // Game Controller doesn't expose a physical HID identity. Only lend a
+    // location to the guest if the connected Stadia is unambiguous.
+    if (devices && CFSetGetCount(devices) == 1) {
+        IOHIDDeviceRef device;
+        CFSetGetValues(devices, (const void **)&device);
+        CFTypeRef transport = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDTransportKey));
+        CFTypeRef key = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDLocationIDKey));
+        if (transport && key && CFGetTypeID(key) == CFNumberGetTypeID()) {
+            if (CFEqual(transport, CFSTR("USB"))) *matched_transport = CFSTR("USB");
+            if (CFEqual(transport, CFSTR("Bluetooth Low Energy"))) *matched_transport = CFSTR("Bluetooth Low Energy");
+            if (*matched_transport) location = (CFNumberRef)CFRetain(key);
+        }
+    }
+    if (devices) CFRelease(devices);
+    CFRelease(manager);
+    return location;
+}
+
+static uint32_t location_id(CFNumberRef location)
+{
+    int64_t id = 0;
+    return location && CFGetTypeID(location) == CFNumberGetTypeID() &&
+        CFNumberGetValue(location, kCFNumberSInt64Type, &id) ? (uint32_t)id : 0;
+}
+
+bool dirt3_gamepad_has_stadia_location(CFNumberRef location)
+{
+    uint32_t id = location_id(location);
+    return id && id == atomic_load_explicit(&stadia_location_id, memory_order_relaxed);
+}
+
+static void set_stadia_location(CFNumberRef location, CFStringRef transport)
+{
+    if (bridge.stadia_location) CFRelease(bridge.stadia_location);
+    bridge.stadia_location = location;
+    bridge.stadia_transport = transport;
+    atomic_store_explicit(&stadia_location_id, location_id(location), memory_order_relaxed);
+}
